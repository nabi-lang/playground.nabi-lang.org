// playground.nabi-lang.org: the page and its compile service.
//
//   POST /api/compile?opt=0|2   body: one Nabi source file (UTF-8, at most
//                               64 KiB). 200: the program as a
//                               wasm32-unknown-unknown module, or nabic's
//                               diagnostics as text with an
//                               `X-Nabi-Diagnostics: 1` header; 400 / 413 /
//                               429 / 503 / 504 for the request itself.
//   POST /api/fmt               body: the same. 200: the source as
//                               `nabi fmt` lays it out, or its
//                               diagnostics (header as above).
//   POST /api/share             body: the same. 200: the id of a short
//                               link that holds the source, stored
//                               under PLAY_SHARES (never compiled or
//                               run here); 400 / 409 / 413 / 429 / 503.
//   GET  /api/share/<id>        the stored source, or 404 (410 when
//                               PLAY_TAKEDOWN names it)
//   GET  /p/<id>                the page with that source in the editor
//   GET  /api/wasm/<sha256>     a module already in the cache, by the key
//                               a compile answered in X-Nabi-Module;
//                               immutable, so a CDN may keep it. 404
//                               when it is not (POST the source then)
//   POST /api/lsp               body: JSON {code, request, line,
//                               character}, request one of completion,
//                               hover, definition (lsp.nabi). 200:
//                               {"result": ..} as nabils answers, run in
//                               the sandbox like a build; 400 / 413 / 429
//                               / 503 / 504 for the request itself
//   GET  /ko, /zh-hans, /zh-hant and their /p/<id>
//                               the same pages in Korean and in
//                               Chinese (lang.nabi)
//   GET  /api/health            200 `ok` and what is there, one
//                               `key value` a line, or 503 and why (no
//                               runner, a sandbox that fails its
//                               check), for uptime checks
//   GET  /...                   static/, then the web kit's files
//                               (web/, built in) and its fonts
//                               (/fonts/, web/assets/fonts), then
//                               PLAY_SITE, and /nabi.mjs
//
// Each compile runs `nabic build --target=wasm32-unknown-unknown` in a
// fresh directory with a clean environment, under PLAY_WRAP (a sandbox
// command line such as bwrap's), killed after PLAY_TIMEOUT seconds (and
// `PLAY_WRAP --kill` run then, which stops a container the killed client
// left running); `nabi fmt` the same way, under FMT_TIMEOUT. At most
// PLAY_JOBS run at once; past that a request waits up to PLAY_QUEUE
// seconds for a turn. Finished modules are cached by the SHA-256 of
// toolchain, packages, level and source, so a shared link compiles once.
//
// A program may use the packages PLAY_PACKAGES names (in dependency
// order), prebuilt for wasm32 under PLAY_DEPS (as nabic sees it):
// `<PLAY_DEPS>/debug/deps/<name>.nabihir` for -O0, `release/` for -O2,
// which scripts/Dockerfile builds into the image.
//
// Settings come from the environment:
//   PLAY_ADDR     127.0.0.1:8405    PLAY_NABIC    nabic
//   PLAY_NABI     the `nabi` beside a PLAY_NABIC path, else nabi
//   PLAY_NABILS   the `nabils` beside a PLAY_NABIC path, else nabils
//   PLAY_SITE     ../nabi-lang.org/static
//   PLAY_MJS      the toolchain's nabi.mjs; by default, for a PLAY_NABIC
//                 path, <its dir>/../lib/nabi/targets/wasm32-unknown-unknown/
//   PLAY_WRAP     ""                PLAY_WORK    <temp>/nabi-playground
//   PLAY_JOBS     the CPU count     PLAY_TIMEOUT 20
//   PLAY_QUEUE    10 (seconds a compile waits for a turn)
//   PLAY_DEPS     ""  PLAY_PACKAGES  json,linalg,specfun,special,stats,..
//   PLAY_RATE     30 (compiles per minute and client)
//   PLAY_SHARES   <PLAY_WORK>/shares: stored share links, one file each
//   PLAY_SHARE_RATE  10 (share links per minute and client)
//   PLAY_SHARE_MAX   100000 (links kept; past it, new ones are refused)
//   PLAY_TAKEDOWN    <PLAY_SHARES>/takedown: share ids taken down, one a
//                 line; re-read when it changes
//   PLAY_LSP_RATE    60 (language requests per minute and client)
//   PLAY_CLIENT_HEADER  (none)  the header a trusted proxy sets with the
//                 real client IP, e.g. cf-connecting-ip behind Cloudflare
//                 or x-forwarded-for behind Caddy. Unset (the default),
//                 the TCP peer is the client, so a client cannot forge it.

mod lang;
mod lsp;

use core::crypto::HashAlgorithm;
use std::env;
use std::fs;
use std::net;
use std::net::TcpStream;
use std::process;
use std::process::{Command, Stdio};
use std::thread;
use std::time::SystemTime;
use web::chrome;
use web::http;
use web::http::Request;
use web::kit;
use web::lang::Lang;
use web::url;

const MAX_SOURCE: usize = 65536;
/// The most a request body may be: an /api/lsp body is the source as a
/// JSON string, its newlines and quotes escaped, so up to about twice it.
const MAX_BODY: usize = 2 * MAX_SOURCE + 4096;
/// Seconds one language request may take: nabils checks the one file and
/// answers, usually in well under a second.
const LSP_TIMEOUT: u64 = 10u64;
/// Language answers kept in memory; past it, all go.
const MAX_LSP_CACHED: usize = 1024;
/// The packages a program may use by default, each after the ones it
/// depends on; `alias=name` is `name` under another name (stats imports
/// special as `specfun`).
const PACKAGES: str = "json,linalg,autodiff,special,specfun=special,signal,units,stats,csv,csvio=csv,table,plot,ode,optimize,interpolate,spatial";
const MAX_CONNS: i64 = 64;
/// Cached modules kept; past it the least recently used quarter goes.
const MAX_CACHED: usize = 256;
/// The most diagnostics text a compile returns (bytes); past it, truncated.
const MAX_DIAG: usize = 65536;
/// The most a returned module may be (bytes); a 64 KiB source cannot
/// honestly produce more, so a larger output is refused.
const MAX_WASM: u64 = 33554432u64;
/// Seconds `nabi fmt` may take: it only lexes and re-indents.
const FMT_TIMEOUT: u64 = 5u64;
/// Characters of a share id: lowercase RFC 4648 base32, 10 of them.
const ID_CHARS: str = "abcdefghijklmnopqrstuvwxyz234567";
const ID_LEN: usize = 10;

static ACTIVE: Atomic<i64> = Atomic::new(0i64);
static JOBS: Atomic<i64> = Atomic::new(0i64);
static SEQ: Atomic<i64> = Atomic::new(0i64);
/// Share links stored, counted at start and on each new one.
static SHARES: Atomic<i64> = Atomic::new(0i64);

struct Cfg {
    addr: str;
    nabic: str;
    /// `nabi`, for `fmt`.
    nabi: str;
    /// `nabils`, for /api/lsp.
    nabils: str = "nabils";
    site: str;
    mjs: str;
    /// The sandbox command line, split at spaces when used (a `List`
    /// would not be `Sync`, and the config goes to every thread).
    wrap: str;
    work: str;
    jobs: i64;
    timeout: u64;
    /// Seconds a request waits for a compile slot before a 503.
    queue: i64 = 10i64;
    /// Where the prebuilt packages are, as nabic sees it; "": none.
    deps: str = "";
    /// The packages a program may use, in dependency order, `,` joined.
    packages: str = "";
    rate: i64;
    client_header: str;
    shares: str;
    share_rate: i64;
    share_max: i64;
    /// The takedown list's path (PLAY_TAKEDOWN).
    takedown: str = "";
    /// Language requests a minute per client.
    lsp_rate: i64 = 60i64;
    /// The og:image version: the first 10 hex digits of og.png's SHA-256,
    /// put in place of index.html's `og.png?v=dev` when it is served.
    og: str;
    /// The toolchain's release (`nabic --version`), put in place of
    /// index.html's `nabi dev`.
    release: str;
    /// static/ts/'s files with their versions, `name=version,..` (the
    /// page's nabi-ts meta): the files only change with a deploy, which
    /// restarts the server, so they are hashed once.
    ts: str = "";
    /// The examples this server cannot build, `,` joined (examples_off):
    /// the page's nabi-examples-off meta.
    examples_off: str = "";
}

fn setting(k: str, dflt: str) -> str {
    let v = try env::var(k) catch _ { "" };
    if v.is_empty() { dflt } else { v }
}

fn words(s: str) -> List<str> {
    let out: List<str> = List::new();
    for w in s.split_whitespace() { out.push(w); }
    out
}

/// `0.1.6` from `nabic 0.1.6 (d0c8492ae 2026-11-01)`, or `dev`.
fn nabic_release(nabic: str) -> str {
    let o = try Command::new(nabic).args(["--version"]).stdin(Stdio::Null).output() catch _ { return "dev"; };
    let w = words((try? str::from_utf8(o.stdout)) ?? "");
    if o.status.success() && w.len() > 1 { w[1] } else { "dev" }
}

/// The `nabi` beside the toolchain's `nabic` (a path), else `nabi`.
fn find_nabi(nabic: str) -> str {
    if let k: usize = nabic.rfind("/") { return nabic[:k] + "/nabi"; }
    "nabi"
}

/// The `nabils` beside the toolchain's `nabic` (a path), else `nabils`.
fn find_nabils(nabic: str) -> str {
    if let k: usize = nabic.rfind("/") { return nabic[:k] + "/nabils"; }
    "nabils"
}

/// The nabi.mjs of the toolchain at `nabic` (a path): its wasm32 runtime's.
fn find_mjs(nabic: str) -> str {
    if let k: usize = nabic.rfind("/") { return nabic[:k] + "/../lib/nabi/targets/wasm32-unknown-unknown/nabi.mjs"; }
    ""
}

fn load_cfg() throws -> Cfg {
    let nabic = setting("PLAY_NABIC", "nabic");
    let mjs = setting("PLAY_MJS", find_mjs(nabic));
    let work = setting("PLAY_WORK", env::temp_dir().as_str() + "/nabi-playground");
    let jobs = try setting("PLAY_JOBS", f"{task::cpu_count()}").parse::<i64>();
    let queue = try setting("PLAY_QUEUE", "10").parse::<i64>();
    let timeout = try setting("PLAY_TIMEOUT", "20").parse::<u64>();
    let rate = try setting("PLAY_RATE", "30").parse::<i64>();
    let share_rate = try setting("PLAY_SHARE_RATE", "10").parse::<i64>();
    let share_max = try setting("PLAY_SHARE_MAX", "100000").parse::<i64>();
    let lsp_rate = try setting("PLAY_LSP_RATE", "60").parse::<i64>();
    let deps = setting("PLAY_DEPS", "");
    let packages = setting("PLAY_PACKAGES", packages_of(deps));
    Cfg { addr: setting("PLAY_ADDR", "127.0.0.1:8405"), nabic: nabic, nabi: setting("PLAY_NABI", find_nabi(nabic)), nabils: setting("PLAY_NABILS", find_nabils(nabic)), site: setting("PLAY_SITE", "../nabi-lang.org/static"), mjs: mjs, wrap: try env::var("PLAY_WRAP") catch _ { "" }, work: work, jobs: jobs, timeout: timeout, rate: rate, client_header: setting("PLAY_CLIENT_HEADER", "").to_lowercase(), shares: setting("PLAY_SHARES", work + "/shares"), takedown: setting("PLAY_TAKEDOWN", setting("PLAY_SHARES", work + "/shares") + "/takedown"), lsp_rate: lsp_rate, share_rate: share_rate, share_max: share_max, queue: queue, deps: deps, packages: packages, examples_off: examples_off(deps, packages), og: og_version(["static", setting("PLAY_SITE", "../nabi-lang.org/static")]), release: nabic_release(nabic), ts: ts_versions() }
}

/// The packages warm.sh built into `deps` (its `packages` file, when
/// the server can read it), else PACKAGES.
fn packages_of(deps: str) -> str {
    if deps.is_empty() { return PACKAGES; }
    let t = (try fs::read_to_str(deps + "/packages") catch _ { "" }).trim();
    if t.is_empty() { PACKAGES } else { t }
}

/// The aliases of a `,` joined package list (`alias=name` or `name`).
fn package_names(list: str) -> List<str> {
    let out: List<str> = List::new();
    for n in list.split(",") {
        let (alias, _) = n.split_once("=") ?? (n, n);
        if !alias.trim().is_empty() { out.push(alias.trim()); }
    }
    out
}

/// Whether `code` names package `n`: `n::..` or `use n`, `n` a whole
/// name and not a path's later part (`std::n::`).
fn uses(code: str, n: str) -> bool {
    let from = 0usize;
    while let k: usize = code[from:].find(n) {
        let at = from + k;
        let end = at + n.len();
        let before = if at == 0 { ' ' } else { code[:at].chars().last() ?? ' ' };
        let rest = code[end:];
        let whole = !is_ident(before) && before != ':' && !is_ident(rest.chars().next() ?? ' ');
        if whole && (rest.starts_with("::") || code[:at].trim_end().ends_with("use")) { return true; }
        from = end;
    }
    false
}

/// The examples (static/examples/, by name) that use a known package
/// this server does not have, sorted and `,` joined: with `deps` empty
/// it has none.
fn examples_off(deps: str, packages: str) -> str {
    let have = if deps.is_empty() { List::new() } else { package_names(packages) };
    let known = package_names(PACKAGES + "," + packages);
    let off: List<str> = List::new();
    for e in (try fs::read_dir("static/examples") catch _ { return ""; }).results() {
        let ent = try e.get() catch _ { continue; };
        let file = ent.file_name();
        if !file.ends_with(".nabi") { continue; }
        let code = code_only(try fs::read_to_str("static/examples/" + file) catch _ { continue; });
        for n in known {
            if !have.contains(n) && uses(code, n) {
                off.push(file[:file.len() - ".nabi".len()]);
                break;
            }
        }
    }
    off.sort();
    off.join(",")
}

/// The version of the og.png that `/og.png` serves from `roots`, or
/// `dev` without one.
fn og_version(roots: List<str>) -> str {
    for root in roots {
        let data = try fs::read(root + "/og.png") catch _ { continue; };
        return http::version(data);
    }
    "dev"
}

fn bytes_of(s: str) -> List<u8> {
    let b: List<u8> = List::new();
    for x in s.as_bytes() { b.push(x); }
    b
}

struct Resp {
    status: i32;
    headers: List<str>;
    body: List<u8>;
}

fn text(status: i32, msg: str) -> Resp {
    Resp { status: status, headers: ["Content-Type: text/plain; charset=utf-8", "Cache-Control: no-store"], body: bytes_of(msg) }
}

/// A program that does not compile is an answer, not a failed request:
/// 200, so the page's console stays clean, marked by its header.
fn diagnostics(msg: str) -> Resp {
    let r = text(200, msg);
    r.headers.push("X-Nabi-Diagnostics: 1");
    r
}

fn hex(bytes: List<u8>) -> str {
    let digits = "0123456789abcdef";
    let out = StrBuf::new();
    for b in bytes {
        out.push_str(digits[(b >> 4u8) as usize:(b >> 4u8) as usize + 1]);
        out.push_str(digits[(b & 15u8) as usize:(b & 15u8) as usize + 1]);
    }
    out.to_str()
}

/// A client's requests in its current one-minute window.
struct Window {
    start: i64;
    count: i64;
}

static CLIENTS: Mutex<Dict<str, Window>> = Mutex::new(Dict::new());

fn now_secs() -> i64 { SystemTime::now().unix_secs() }

fn allow(client: str, rate: i64) -> bool {
    using g = CLIENTS.lock() {
        let d = g.get();
        let t = now_secs();
        // Drop windows older than the minute so the table stays small,
        // without resetting everyone (which an attacker could force).
        if d.len() > 2048 {
            let keep: Dict<str, Window> = Dict::new();
            for (k, w) in d.iter() {
                if t - w.start < 60i64 { keep.insert(k, w); }
            }
            d = keep;
            g.set(d);
        }
        let w = d.get(client) ?? Window { start: t, count: 0i64 };
        if t - w.start >= 60i64 { w = Window { start: t, count: 0i64 }; }
        w.count += 1i64;
        d.insert(client, w);
        w.count <= rate
    }
}

/// The client for rate limiting, as rate_key groups it. Without a
/// trusted-proxy header the TCP peer is used, so a client cannot forge
/// its identity; a direct client's own X-Forwarded-For is ignored. With
/// one (PLAY_CLIENT_HEADER), its value is trusted, taking the LAST entry
/// of a list header, which is the one the proxy appended (a client may
/// prepend fakes, not append).
fn client_of(s: TcpStream, r: Request, header: str) -> str {
    if !header.is_empty() {
        let v = r.header(header);
        if !v.is_empty() {
            if let k: usize = v.rfind(",") { return rate_key(v[k + 1:].trim()); }
            return rate_key(v.trim());
        }
    }
    let a = try s.peer_addr() catch _ { return "?"; };
    let t = f"{a}";
    rate_key(if let k: usize = t.rfind(":") { t[:k] } else { t })
}

/// The address a client's budget is kept under: an IPv4 address as it
/// is, an IPv6 one by its /64 (`2001:db8:1:2::/64`), since one host
/// usually holds a whole /64 and could hop through it. An IPv4-mapped
/// IPv6 address is its IPv4 one; anything unparsable stays as given.
fn rate_key(ip: str) -> str {
    let a = ip.trim_start_matches("[").trim_end_matches("]");
    if let k: usize = a.find("%") { a = a[:k]; }
    if !a.contains(":") { return a; }
    let low = a.to_lowercase();
    if low.starts_with("::ffff:") && low.contains(".") { return low["::ffff:".len():]; }
    let groups: List<str> = List::new();
    if let (head, tail) = low.split_once("::") {
        if tail.contains("::") { return ip; }
        let h = hextets(head) ?? { return ip; };
        let t = hextets(tail) ?? { return ip; };
        if h.len() + t.len() > 7 { return ip; }
        for g in h { groups.push(g); }
        for _ in 0..8 - h.len() - t.len() { groups.push("0"); }
        for g in t { groups.push(g); }
    } else {
        groups = hextets(low) ?? { return ip; };
        if groups.len() != 8 { return ip; }
    }
    f"{groups[0]}:{groups[1]}:{groups[2]}:{groups[3]}::/64"
}

/// The hextets of one side of an IPv6 address, leading zeros dropped;
/// an embedded IPv4 tail counts as two. None when one is not hex.
fn hextets(s: str) -> List<str> | none {
    let out: List<str> = List::new();
    if s.is_empty() { return out; }
    for g in s.split(":") {
        if g.contains(".") {
            out.push("0");
            out.push("0");
            continue;
        }
        if g.is_empty() || g.len() > 4 { return none; }
        for c in g.chars() {
            if !"0123456789abcdef".contains(f"{c}") { return none; }
        }
        let t = g.trim_start_matches("0");
        out.push(if t.is_empty() { "0" } else { t });
    }
    out
}

/// What the playground does not compile: reading files at compile time
/// (`include_str!`, `include_bytes!`, `#[path]`, WIT imports). The
/// sandbox is what keeps the server's files out of reach; this only says
/// so plainly.
/// Only code counts: a comment or a string that names one of them is
/// fine.
fn refused(src: str) -> str | none {
    let code = code_only(src);
    let dense = StrBuf::new();
    for c in code.chars() {
        if !c.is_whitespace() { dense.push(c); }
    }
    let flat = dense.to_str();
    for (word, what) in [("include_str", "include_str!"), ("include_bytes", "include_bytes!")] {
        if has_word(code, word) { return refusal(what); }
    }
    for (word, what) in [("#[path", "#[path(..)]"), ("#![path", "#[path(..)]"), ("wit::import", "WIT imports"), ("wit::export", "WIT exports")] {
        if flat.contains(word) { return refusal(what); }
    }
    none
}

fn refusal(what: str) -> str {
    f"error: the playground does not compile {what}: a program here is one file and reads nothing at compile time\n"
}

fn is_ident(c: char) -> bool { c.is_alphanumeric() || c == '_' }

/// Whether `word` is in `code` as a whole identifier.
fn has_word(code: str, word: str) -> bool {
    let from = 0usize;
    while let k: usize = code[from:].find(word) {
        let at = from + k;
        let end = at + word.len();
        let before = if at == 0 { ' ' } else { code[:at].chars().last() ?? ' ' };
        let after = code[end:].chars().next() ?? ' ';
        if !is_ident(before) && !is_ident(after) { return true; }
        from = end;
    }
    false
}

/// `src` with its comments and the text of its string and char literals
/// blanked; an f-string's `{..}` parts stay, as they are code.
fn code_only(src: str) -> str {
    let cs: List<char> = List::new();
    for c in src.chars() { cs.push(c); }
    let out = StrBuf::new();
    let n = cs.len();
    let i = 0usize;
    while i < n {
        let c = cs[i];
        let next = if i + 1 < n { cs[i + 1] } else { ' ' };
        if c == '/' && next == '/' {
            while i < n && cs[i] != '\n' { i += 1; }
            continue;
        }
        if c == '/' && next == '*' {
            let depth = 0usize;
            while i < n {
                if i + 1 < n && cs[i] == '/' && cs[i + 1] == '*' { depth += 1; i += 2; continue; }
                if i + 1 < n && cs[i] == '*' && cs[i + 1] == '/' {
                    depth -= 1;
                    i += 2;
                    if depth == 0 { break; }
                    continue;
                }
                i += 1;
            }
            out.push(' ');
            continue;
        }
        if c == 'r' && (next == '"' || next == '#') && (i == 0 || !is_ident(cs[i - 1])) {
            // r"..", r#".."#
            let j = i + 1;
            let hashes = 0usize;
            while j < n && cs[j] == '#' { hashes += 1; j += 1; }
            if j < n && cs[j] == '"' {
                j += 1;
                while j < n {
                    if cs[j] == '"' {
                        let h = 0usize;
                        while h < hashes && j + 1 + h < n && cs[j + 1 + h] == '#' { h += 1; }
                        if h == hashes { j += 1 + hashes; break; }
                    }
                    j += 1;
                }
                out.push_str("r\"\"");
                i = j;
                continue;
            }
        }
        if c == '"' {
            let fmt = i > 0 && cs[i - 1] == 'f';
            out.push('"');
            i += 1;
            while i < n && cs[i] != '"' {
                if cs[i] == '\\' { i += 2; continue; }
                if fmt && cs[i] == '{' {
                    if i + 1 < n && cs[i + 1] == '{' { i += 2; continue; }
                    let depth = 0usize;
                    while i < n {
                        if cs[i] == '{' { depth += 1; }
                        if cs[i] == '}' {
                            depth -= 1;
                            if depth == 0 { break; }
                        }
                        out.push(cs[i]);
                        i += 1;
                    }
                    out.push(' ');
                }
                i += 1;
            }
            out.push('"');
            i += 1;
            continue;
        }
        if c == '\'' {
            // 'x', '\n', '\u{..}'; a lone ' (a label) stays.
            if next == '\\' {
                let j = i + 2;
                while j < n && cs[j] != '\'' && cs[j] != '\n' { j += 1; }
                if j < n && cs[j] == '\'' { out.push_str("' '"); i = j + 1; continue; }
            } else if i + 2 < n && cs[i + 2] == '\'' {
                out.push_str("' '");
                i += 3;
                continue;
            }
        }
        out.push(c);
        i += 1;
    }
    out.to_str()
}

/// nabic's diagnostics as the reader should see them: the work
/// directory's paths gone, the progress lines dropped.
fn tidy(err: str, dir: str) -> str {
    let out = StrBuf::new();
    for line in err.replace(dir + "/", "").lines() {
        let t = line.trim();
        if t.starts_with("Compiling ") || t.starts_with("Building ") || t.starts_with("Finished ") { continue; }
        out.push_str(line);
        out.push('\n');
    }
    out.to_str().trim_end() + "\n"
}

/// The module cache's key for `src` at level `opt`: the SHA-256 of the
/// toolchain, the packages, the level and the source, in hex.
fn module_key(cfg: Cfg, src: str, opt: str) -> str {
    hex(HashAlgorithm::Sha256.digest(f"{cfg.release}\n{cfg.deps}\n{cfg.packages}\n{opt}\n{src}".as_bytes()))
}

/// The cached module under `key`, renewed for the eviction's order, or
/// none.
fn cached_module(cfg: Cfg, key: str) -> List<u8> | none {
    let path = cfg.work + "/cache/" + key + ".wasm";
    let md = try fs::symlink_metadata(path) catch _ { return none; };
    if !md.is_file() || md.len() == 0u64 || md.len() > MAX_WASM { return none; }
    let wasm = try fs::read(path) catch _ { return none; };
    touch(path, wasm);
    wasm
}

fn compile(cfg: Cfg, src: str, opt: str) -> Resp {
    let key = module_key(cfg, src, opt);
    if let wasm: List<u8> = cached_module(cfg, key) {
        return Resp { status: 200, headers: ["Content-Type: application/wasm", "Cache-Control: no-store", "X-Nabi-Cache: hit", "X-Nabi-Module: " + key], body: wasm };
    }
    if !take_slot(cfg) { return busy(); }
    let r = run_nabic(cfg, src, opt, key);
    JOBS.fetch_sub(1i64);
    r
}

/// Requests waiting for a compile slot.
static WAITING: Atomic<i64> = Atomic::new(0i64);

/// A compile slot, waited for up to PLAY_QUEUE seconds; false when none
/// came, or when the queue is already four times PLAY_JOBS long.
fn take_slot(cfg: Cfg) -> bool {
    if JOBS.fetch_add(1i64) < cfg.jobs { return true; }
    JOBS.fetch_sub(1i64);
    if WAITING.fetch_add(1i64) >= 4i64 * cfg.jobs {
        WAITING.fetch_sub(1i64);
        return false;
    }
    let t0 = Instant::now();
    let got = false;
    while t0.elapsed().as_ms() < cfg.queue * 1000i64 {
        thread::sleep(Duration::ms(50));
        if JOBS.fetch_add(1i64) < cfg.jobs {
            got = true;
            break;
        }
        JOBS.fetch_sub(1i64);
    }
    WAITING.fetch_sub(1i64);
    got
}

/// A cache hit renews its file's time, so eviction takes the least
/// recently used first; at most once a minute per file.
fn touch(path: str, data: List<u8>) {
    let md = try fs::metadata(path) catch _ { return; };
    let t = try md.modified() catch _ { return; };
    if now_secs() - t.unix_secs() < 60i64 { return; }
    try fs::write(path, data) catch _ {};
}

/// Room for one more file in `dir`: with `max` or more there, the least
/// recently used quarter goes.
fn make_room(dir: str, max: usize) {
    let all: List<(i64, str)> = List::new();
    for e in (try fs::read_dir(dir) catch _ { return; }).results() {
        let ent = try e.get() catch _ { continue; };
        let name = ent.file_name();
        let md = try fs::metadata(dir + "/" + name) catch _ { continue; };
        let t = try md.modified() catch _ { continue; };
        all.push((t.unix_nanos(), name));
    }
    if all.len() < max { return; }
    all.sort_by_key(|x: (i64, str)| x.0);
    let excess = all.len() - max + max / 4;
    for k in 0..excess { try fs::remove_file(dir + "/" + all[k].1) catch _ {}; }
}

fn busy() -> Resp {
    let r = text(503, "The compile server is busy; try again in a moment.");
    r.headers.push("Retry-After: 5");
    r
}

/// The packages `src` may use, each as nabic's `--extern`, when it names
/// one of them (`stats::`, `use plot`); none otherwise, which keeps a
/// plain program's build as small as before.
fn externs(cfg: Cfg, src: str, opt: str) -> List<str> {
    let out: List<str> = List::new();
    if cfg.deps.is_empty() { return out; }
    let names: List<(str, str)> = List::new();
    for n in cfg.packages.split(",") {
        let (alias, file) = n.split_once("=") ?? (n, n);
        if !alias.trim().is_empty() { names.push((alias.trim(), file.trim())); }
    }
    let used = false;
    for (n, _) in names {
        if src.contains(n + "::") || src.contains("use " + n) { used = true; }
    }
    if !used { return out; }
    let profile = if opt == "0" { "debug" } else { "release" };
    for (n, file) in names {
        out.push("--extern");
        out.push(f"{n}={cfg.deps}/{profile}/deps/{file}.nabihir");
    }
    out
}

fn run_nabic(cfg: Cfg, src: str, opt: str, key: str) -> Resp {
    let dir = f"{cfg.work}/jobs/{std::process::id()}-{SEQ.fetch_add(1i64)}";
    try fs::create_dir_all(dir) catch e { return text(500, f"work directory: {e}"); };
    let resp = build_in(cfg, src, opt, key, dir);
    try fs::remove_dir_all(dir) catch _ {};
    resp
}

/// Runs `prog <args>` (`nabic` or `nabi`) in `dir` under the sandbox, its
/// output in `dir/tool.log`: whether it succeeded, or the answer when it
/// could not run or took longer than `secs`.
fn run_tool(cfg: Cfg, prog: str, dir: str, args: List<str>, secs: u64, what: str) -> bool | Resp {
    run_piped(cfg, prog, dir, args, secs, what, "")
}

/// run_tool with `input` as the tool's stdin (from `dir/tool.in`) and
/// its stdout in `dir/tool.out` apart from stderr's tool.log, when
/// `input` is not empty.
fn run_piped(cfg: Cfg, prog: str, dir: str, args: List<str>, secs: u64, what: str, input: str) -> bool | Resp {
    let piped = !input.is_empty();
    if piped { try fs::write(dir + "/tool.in", input) catch e { return text(500, f"work directory: {e}"); }; }
    let log = try fs::create(dir + "/tool.log") catch e { return text(500, f"work directory: {e}"); };
    let out = try (if piped { try fs::create(dir + "/tool.out") } else { try log.try_clone() }) catch e {
        try log.close() catch _ {};
        return text(500, f"work directory: {e}");
    };
    let stdin = Stdio::Null;
    if piped {
        let f = try fs::open(dir + "/tool.in") catch e {
            try log.close() catch _ {};
            try out.close() catch _ {};
            return text(500, f"work directory: {e}");
        };
        stdin = Stdio::File(f);
    }
    let argv: List<str> = List::new();
    for w in words(cfg.wrap) { argv.push(w); }
    argv.push(prog);
    for a in args { argv.push(a); }
    let cmd = sandboxed(Command::new(argv[0]).args(argv[1:argv.len()].to_list()).current_dir(dir), dir, secs)
        .stdin(stdin).stdout(Stdio::File(out)).stderr(Stdio::File(log)).kill_on_drop(true);
    // The command owns its files and closes them once spawned.
    let child = try cmd.spawn() catch e { return text(500, f"cannot start {prog}: {e}"); };
    let t0 = Instant::now();
    let limit = (secs as i64) * 1000i64;
    loop {
        let st = try child.try_wait() catch e { return text(500, f"{prog}: {e}"); };
        if let s: std::process::ExitStatus = st { return s.success(); }
        if t0.elapsed().as_ms() > limit {
            try child.kill() catch _ {};
            try child.wait() catch _ {};
            stop_sandbox(cfg, dir, secs);
            return text(504, f"{what} took longer than {secs} s and was stopped.");
        }
        thread::sleep(Duration::ms(25));
    }
}

/// `cmd` with a clean environment: no NABI_* / NABIC_* settings reach the
/// tool, its home and caches are the job's own directory. The sandbox's
/// own settings (PLAY_IMAGE, PLAY_MEM, PLAY_CPUS, PLAY_PIDS, DOCKER_HOST,
/// and the user manager's XDG_RUNTIME_DIR and DBUS_SESSION_BUS_ADDRESS
/// for sandbox.sh's systemd-run) and PLAY_DEPS (bwrap binds it) pass
/// through to the wrap command, and
/// PLAY_LIMIT tells it the time limit;
/// scripts/sandbox.sh clears them before the tool runs.
fn sandboxed(cmd: Command, dir: str, secs: u64) -> Command {
    let c = cmd.env_clear()
        .env("PATH", "/usr/bin:/bin").env("HOME", dir).env("TMPDIR", dir).env("NABI_HOME", dir + "/.nabi")
        .env("XDG_CACHE_HOME", dir + "/.cache").env("NO_COLOR", "1").env("NABI_INCREMENTAL", "0")
        .env("PLAY_LIMIT", f"{secs}");
    for k in ["PLAY_IMAGE", "PLAY_MEM", "PLAY_CPUS", "PLAY_PIDS", "DOCKER_HOST", "PLAY_DEPS", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS"] {
        let v = try env::var(k) catch _ { "" };
        if !v.is_empty() { c = c.env(k, v); }
    }
    c
}

/// After a timeout: `PLAY_WRAP --kill` in the job directory, so a
/// sandbox that outlives its killed client (a container) is stopped
/// too; waited for up to 10 s.
fn stop_sandbox(cfg: Cfg, dir: str, secs: u64) {
    let argv = words(cfg.wrap);
    if argv.is_empty() { return; }
    argv.push("--kill");
    let child = try sandboxed(Command::new(argv[0]).args(argv[1:argv.len()].to_list()).current_dir(dir), dir, secs)
        .stdin(Stdio::Null).stdout(Stdio::Null).stderr(Stdio::Null).spawn() catch e {
            eprintln(f"stop sandbox: {e}");
            return;
        };
    let t0 = Instant::now();
    loop {
        let st = try child.try_wait() catch _ { return; };
        if st is std::process::ExitStatus { return; }
        if t0.elapsed().as_ms() > 10000i64 {
            try child.kill() catch _ {};
            try child.wait() catch _ {};
            eprintln("stop sandbox: still running after 10 s");
            return;
        }
        thread::sleep(Duration::ms(25));
    }
}

fn build_in(cfg: Cfg, src: str, opt: str, key: str, dir: str) -> Resp {
    try fs::write(dir + "/main.nabi", src) catch e { return text(500, f"work directory: {e}"); };
    let args: List<str> = ["build", "--target=wasm32-unknown-unknown", "-O" + opt, "--target-dir", "t"];
    args.extend(externs(cfg, src, opt));
    for a in ["main.nabi", "-o", "main.wasm"] { args.push(a); }
    let ran = run_tool(cfg, cfg.nabic, dir, args, cfg.timeout, "Compiling");
    if let r: Resp = ran { return r; }
    let ok = if let b: bool = ran { b } else { false };
    let err = try fs::read_to_str(dir + "/tool.log") catch _ { "" };
    if !ok || !fs::exists(dir + "/main.wasm") {
        let diag = tidy(err, dir);
        return diagnostics(if diag.len() > MAX_DIAG { diag[:MAX_DIAG] + "\n... (truncated)\n" } else { diag });
    }
    let md = try fs::symlink_metadata(dir + "/main.wasm") catch e { return text(500, f"nabic output: {e}"); };
    // The compile runs as this same user in a writable job dir; never
    // follow a planted symlink, and never ship an implausibly large module.
    if !md.is_file() { return diagnostics("the build did not produce a module\n"); }
    if md.len() > MAX_WASM { return diagnostics("the module is too large\n"); }
    let wasm = try fs::read(dir + "/main.wasm") catch e { return text(500, f"nabic output: {e}"); };
    try fs::create_dir_all(cfg.work + "/cache") catch _ {};
    make_room(cfg.work + "/cache", MAX_CACHED);
    try fs::rename(dir + "/main.wasm", cfg.work + "/cache/" + key + ".wasm") catch _ {};
    Resp { status: 200, headers: ["Content-Type: application/wasm", "Cache-Control: no-store", "X-Nabi-Cache: miss", "X-Nabi-Module: " + key], body: wasm }
}

/// GET /api/wasm/<key>: a module the cache already holds, kept by
/// browsers and the CDN for good (a key names one module), so a page
/// that knows the key loads it without a compile request.
fn wasm_by_key(cfg: Cfg, key: str) -> Resp {
    if !valid_key(key) { return text(404, "No such module: the address takes the 64 hex digits of X-Nabi-Module."); }
    let wasm = cached_module(cfg, key) ?? { return text(404, "This module is not in the cache; POST the source to /api/compile."); };
    Resp { status: 200, headers: ["Content-Type: application/wasm", http::IMMUTABLE, "X-Nabi-Cache: hit"], body: wasm }
}

/// Whether `key` could be a module key: 64 lowercase hex digits.
fn valid_key(key: str) -> bool {
    if key.len() != 64 { return false; }
    for c in key.chars() {
        if !"0123456789abcdef".contains(f"{c}") { return false; }
    }
    true
}

/// `nabi fmt` on the source, in a job directory of its own: the source
/// laid out, or why not. `nabi fmt` only lexes the one file it is given,
/// but it runs sandboxed like a build all the same.
fn format(cfg: Cfg, src: str) -> Resp {
    if !take_slot(cfg) { return busy(); }
    let dir = f"{cfg.work}/jobs/{std::process::id()}-{SEQ.fetch_add(1i64)}";
    let r = format_in(cfg, src, dir);
    try fs::remove_dir_all(dir) catch _ {};
    JOBS.fetch_sub(1i64);
    r
}

fn format_in(cfg: Cfg, src: str, dir: str) -> Resp {
    try fs::create_dir_all(dir) catch e { return text(500, f"work directory: {e}"); };
    try fs::write(dir + "/main.nabi", src) catch e { return text(500, f"work directory: {e}"); };
    let ran = run_tool(cfg, cfg.nabi, dir, ["fmt", "main.nabi"], FMT_TIMEOUT, "Formatting");
    if let r: Resp = ran { return r; }
    let ok = if let b: bool = ran { b } else { false };
    if !ok {
        // `nabi fmt` names the file `<fmt>`; here it is main.nabi.
        let err = (try fs::read_to_str(dir + "/tool.log") catch _ { "" }).replace("<fmt>:", "main.nabi:");
        let diag = tidy(err, dir);
        return diagnostics(if diag.len() > MAX_DIAG { diag[:MAX_DIAG] + "\n... (truncated)\n" } else { diag });
    }
    // Layout only re-indents, so the result is about the source's size;
    // never follow a planted symlink, never return much more.
    let md = try fs::symlink_metadata(dir + "/main.nabi") catch e { return text(500, f"nabi fmt output: {e}"); };
    if !md.is_file() || md.len() > (MAX_SOURCE * 4) as u64 { return diagnostics("nabi fmt did not leave a usable file\n"); }
    let out = try fs::read_to_str(dir + "/main.nabi") catch e { return diagnostics(f"nabi fmt output: {e}\n"); };
    text(200, out)
}

/// Language answers by key (lsp_key): a page asks the same thing often
/// (a hover moved off and back, a completion retyped).
static LSP_CACHE: Mutex<Dict<str, str>> = Mutex::new(Dict::new());

/// The answer cache's key for `a`: toolchain, packages, request,
/// position and source.
fn lsp_key(cfg: Cfg, a: lsp::Ask) -> str {
    hex(HashAlgorithm::Sha256.digest(f"{cfg.release}\n{cfg.deps}\n{cfg.packages}\n{a.request}\n{a.line}:{a.character}\n{a.code}".as_bytes()))
}

/// POST /api/lsp: one completion, hover or definition from a nabils run
/// for this request alone, in a job directory under the sandbox like a
/// build. It takes a compile slot only when one is free at once, so
/// typing never queues ahead of Run; the page drops what does not come.
fn language(cfg: Cfg, body: str) -> Resp {
    let ask = lsp::parse_ask(body);
    if let why: str = ask { return text(400, f"{why}."); }
    let a = if let x: lsp::Ask = ask { x } else { return text(400, "Bad request."); };
    if a.code.len() > MAX_SOURCE { return too_large(); }
    let key = lsp_key(cfg, a);
    let hit = using g = LSP_CACHE.lock() { g.get().get(key) };
    if let v: str = hit { return json(v, "hit"); }
    if JOBS.fetch_add(1i64) >= cfg.jobs {
        JOBS.fetch_sub(1i64);
        return busy();
    }
    let dir = f"{cfg.work}/jobs/{std::process::id()}-{SEQ.fetch_add(1i64)}";
    let r = language_in(cfg, a, dir);
    try fs::remove_dir_all(dir) catch _ {};
    JOBS.fetch_sub(1i64);
    if r.status == 200 {
        let v = try str::from_utf8(r.body[0:r.body.len()]) catch _ { "" };
        using g = LSP_CACHE.lock() {
            let d = g.get();
            if d.len() >= MAX_LSP_CACHED {
                d = Dict::new();
                g.set(d);
            }
            d.insert(key, v);
        }
    }
    r
}

fn language_in(cfg: Cfg, a: lsp::Ask, dir: str) -> Resp {
    try fs::create_dir_all(dir) catch e { return text(500, f"work directory: {e}"); };
    // The packages as nabic gets them for -O0, when the code names one.
    let ran = run_piped(cfg, cfg.nabils, dir, externs(cfg, a.code, "0"), LSP_TIMEOUT, "The language request", lsp::session(a));
    if let r: Resp = ran { return r; }
    let out = try fs::read_to_str(dir + "/tool.out") catch _ { "" };
    if let v: str = lsp::answer(out) { return json(v, "miss"); }
    let err = (try fs::read_to_str(dir + "/tool.log") catch _ { "" }).trim();
    eprintln(f"lsp: no answer from {cfg.nabils}: {(err.lines().next() ?? "").trim()}");
    text(502, "The language server gave no answer; the editor works without it.")
}

fn json(v: str, cache: str) -> Resp {
    Resp { status: 200, headers: ["Content-Type: application/json", "Cache-Control: no-store", "X-Nabi-Cache: " + cache], body: bytes_of(v) }
}

fn too_large() -> Resp { text(413, "The source is over 64 KiB; make it shorter.") }

/// The id of `src`, and the name of the file a share link stores it in:
/// the first 50 bits of its SHA-256 in base32, so the same code is
/// always the same link.
fn share_id(src: str) -> str {
    let d = HashAlgorithm::Sha256.digest(src.as_bytes());
    let v = 0u64;
    for k in 0..8 { v = (v << 8u64) | (d[k] as u64); }
    let out = StrBuf::new();
    for k in 0..ID_LEN {
        let i = ((v >> (59u64 - 5u64 * (k as u64))) & 31u64) as usize;
        out.push_str(ID_CHARS[i:i + 1]);
    }
    out.to_str()
}

/// Whether `id` could be a share id; anything else never reaches the
/// file system.
fn valid_id(id: str) -> bool {
    if id.len() != ID_LEN { return false; }
    for c in id.chars() {
        if !ID_CHARS.contains(f"{c}") { return false; }
    }
    true
}

/// Store `src` and answer its id. An existing file is never rewritten:
/// the same id holds the same code, and a different code under it (a
/// hash collision) is refused, so the page falls back to a #code link.
fn share(cfg: Cfg, src: str) -> Resp {
    let id = share_id(src);
    if taken_down(cfg, id) { return text(410, "This code was taken down, so it gets no short link."); }
    let path = cfg.shares + "/" + id + ".nabi";
    if fs::exists(path) {
        let old = try fs::read_to_str(path) catch _ { "" };
        return if old == src { text(200, id) } else { text(409, "Cannot make a short link for this code.") };
    }
    if SHARES.load() >= cfg.share_max { return text(503, "No room for new short links."); }
    try fs::create_dir_all(cfg.shares) catch e {
        eprintln(f"share: {e}");
        return text(500, "Cannot store the link.");
    };
    try fs::write_atomic(path, src) catch e {
        eprintln(f"share: {e}");
        return text(500, "Cannot store the link.");
    };
    SHARES.fetch_add(1i64);
    text(200, id)
}

/// The source stored under `id`, or none.
fn shared(cfg: Cfg, id: str) -> str | none {
    if !valid_id(id) { return none; }
    let path = cfg.shares + "/" + id + ".nabi";
    let md = try fs::symlink_metadata(path) catch _ { return none; };
    if !md.is_file() || md.len() > MAX_SOURCE as u64 { return none; }
    try fs::read_to_str(path) catch _ { none }
}

/// The takedown list as last read: when its file was last looked at,
/// its size and time then, and the ids in it.
struct Takedown {
    checked: i64;
    stamp: str;
    ids: Dict<str, bool>;
}

static TAKEDOWN: Mutex<Takedown> = Mutex::new(Takedown { checked: 0i64, stamp: "", ids: Dict::new() });

/// Seconds between looks at the takedown file, so a share request costs
/// at most one stat a while.
const TAKEDOWN_TTL: i64 = 2i64;

/// Whether share `id` was taken down: PLAY_TAKEDOWN names it. The file
/// is read again when its size or time changes, so an edit takes effect
/// within TAKEDOWN_TTL without a restart.
fn taken_down(cfg: Cfg, id: str) -> bool {
    if cfg.takedown.is_empty() { return false; }
    using g = TAKEDOWN.lock() {
        let t = g.get();
        let now = now_secs();
        if t.checked == 0i64 || now - t.checked >= TAKEDOWN_TTL {
            t.checked = now;
            let stamp = file_stamp(cfg.takedown);
            if stamp != t.stamp {
                t.stamp = stamp;
                t.ids = read_takedown(cfg.takedown);
                eprintln(f"takedown: {t.ids.len()} share ids from {cfg.takedown}");
            }
            g.set(t);
        }
        t.ids.contains_key(id)
    }
}

/// `<size>:<mtime>` of the file at `path`, or "" when there is none.
fn file_stamp(path: str) -> str {
    let md = try fs::metadata(path) catch _ { return ""; };
    let t = try md.modified() catch _ { return f"{md.len()}:"; };
    f"{md.len()}:{t.unix_nanos()}"
}

/// The share ids in a takedown file: one a line, as an id, a /p/<id>
/// path or a whole link; blank lines and `#` comments are skipped.
fn read_takedown(path: str) -> Dict<str, bool> {
    let ids: Dict<str, bool> = Dict::new();
    let text = try fs::read_to_str(path) catch _ { return ids; };
    for line in text.lines() {
        let t = line.trim();
        if let k: usize = t.find("#") { t = t[:k].trim(); }
        if let k: usize = t.rfind("/") { t = t[k + 1:]; }
        if valid_id(t) { ids.insert(t, true); }
    }
    ids
}

fn count_shares(dir: str) -> i64 {
    let n = 0i64;
    for e in (try fs::read_dir(dir) catch _ { return 0i64; }).results() {
        let ent = try e.get() catch _ { continue; };
        if ent.file_name().ends_with(".nabi") { n += 1i64; }
    }
    n
}

/// The page with a stored source in it: in a hidden <pre> the script
/// reads (the newline after <pre> is the one the parser drops), and kept
/// out of search results.
/// The <pre> also names the modules of the source the cache holds,
/// `data-wasm0` and `data-wasm2` by level, so Run can GET them
/// (/api/wasm/<key>) instead of asking for a compile.
fn shared_page(cfg: Cfg, src: str, at: str, l: Lang) -> Resp | none {
    let r = page_in(cfg, "static/index.html", at, l) ?? { return none; };
    let html = try str::from_utf8(r.body[0:r.body.len()]) catch _ { return none; };
    let mods = StrBuf::new();
    for opt in ["0", "2"] {
        let key = module_key(cfg, src, opt);
        if fs::exists(cfg.work + "/cache/" + key + ".wasm") { mods.push_str(f" data-wasm{opt}=\"{key}\""); }
    }
    // index.html has one <title> and one <main>.
    r.body = bytes_of(html.replace("<title>", "<meta name=\"robots\" content=\"noindex\">\n<title>")
        .replace("<main ", f"<pre id=\"shared\" hidden{mods.to_str()}>\n{chrome::esc(src)}</pre>\n<main "));
    r
}

/// 410 for a share that was taken down: a short page saying so, or
/// plain text under /api/.
fn gone_in(cfg: Cfg, p: str, l: Lang) -> Resp {
    let w = lang::words(l);
    let plain = text(410, w.gone_plain);
    if p.starts_with("/api/") { return plain; }
    let r = file_resp("static/404.html") ?? { return plain; };
    let html = try str::from_utf8(r.body[0:r.body.len()]) catch _ { return plain; };
    let mail = "<a href=\"mailto:privacy@nabi-lang.org\">privacy@nabi-lang.org</a>";
    let title = f"<title>{w.gone_title}</title>";
    let body = chrome::not_found(w.gone, w.gone_pre + mail + w.gone_post, [(lang::path_in("/", l), w.back)]);
    r.body = bytes_of(page_text(cfg, html.replace("<title>Not found · Nabi Playground</title>", title).replace("<!--web:not-found-->", body), "/", l));
    r.status = 410;
    r
}

/// The page's own headers: scripts and workers from here only (and the
/// Cloudflare Web Analytics beacon the proxy injects), wasm compiled from
/// what the API returns, fonts from here (the kit's). Style
/// attributes are allowed only because WebKit's own <select> shadow DOM
/// uses them; an attribute cannot hold a selector, and anything it loads
/// still meets img-src/font-src. <style> and stylesheets stay strict.
const CSP: str = "Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" + http::REPORT_TO;

fn file_resp(path: str) -> Resp | none {
    let data = try fs::read(path) catch _ { return none; };
    Resp { status: 200, headers: [f"Content-Type: {http::content_type(path)}", "Cache-Control: no-cache", CSP, http::REPORTING], body: data }
}

/// A file of the web kit, by its public path.
fn kit_resp(path: str) -> Resp | none {
    let f = kit::find(path[1:]) ?? { return none; };
    let b: List<u8> = List::new();
    for x in f.data { b.push(x); }
    Resp { status: 200, headers: [f"Content-Type: {http::content_type(f.name)}", "Cache-Control: no-cache", CSP, http::REPORTING], body: b }
}

/// A webfont of the kit (`/fonts/...`), from its files beside the server
/// (kit::FONTS_DIR): they are not built in.
fn font_resp(path: str) -> Resp | none {
    let rest = path.strip_prefix("/fonts/") ?? { return none; };
    if rest.ends_with(".md") { return none; }
    file_resp(http::static_file(kit::FONTS_DIR, "/" + rest) ?? { return none; })
}

/// The pages' shared markup, from the kit's chrome: each
/// `<!--web:name-->` placeholder replaced.
fn fill(html: str, l: Lang) -> str {
    let docs = if l.is_en() { "https://docs.nabi-lang.org/latest" } else { "https://docs.nabi-lang.org/latest/" + l.slug() };
    let sites = chrome::Sites { home: "https://nabi-lang.org", docs: docs, registry: "https://packages.nabi-lang.org", playground: lang::path_in("/", l), current: "playground" };
    let lost = chrome::not_found(l.words().not_found, lang::words(l).no_page, [(lang::path_in("/", l), lang::words(l).back)]);
    html.replace("<!--web:fonts-->\n", chrome::fonts_for("/", l)).replace("<!--web:theme-button-->", chrome::theme_button_for(l)).replace("<!--web:header-sites-->", chrome::header_sites_for(sites, l)).replace("<!--web:credits-->", f"<span>{chrome::LICENSE}</span> · {chrome::MADE_BY}").replace("<!--web:social-->", chrome::SOCIAL).replace("<!--web:legal-->", chrome::legal_links_with(l, "playground.nabi-lang.org")).replace("<!--web:theme-seg-->", chrome::theme_seg_for(l)).replace("<!--web:not-found-->", lost).replace("<!--web:wordmark-->", chrome::wordmark("Nabi"))
            .replace("<!--web:icons-->\n", chrome::icons("/"))
}

/// The note's list of the packages a program may use, each linked to
/// its page on the registry.
fn packages_note(cfg: Cfg, l: Lang) -> str {
    if cfg.deps.is_empty() { return ""; }
    let names: List<str> = List::new();
    for n in cfg.packages.split(",") {
        let (alias, _) = n.split_once("=") ?? (n, n);
        let a = alias.trim();
        if !a.is_empty() && !n.contains("=") { names.push(f"<a href=\"https://packages.nabi-lang.org/packages/{chrome::esc(a)}\">{chrome::esc(a)}</a>"); }
    }
    if names.is_empty() { return ""; }
    names.sort();
    let w = lang::words(l);
    w.packages + names.join(w.sep) + w.stop
}

/// A page with the og:image version, the shared markup and the asset
/// versions filled in: a new og.png is a new URL, so link previews
/// refetch it.
fn page_resp(cfg: Cfg, path: str) -> Resp | none { page_in(cfg, path, "/", Lang::En) }

/// page_resp for the page at `at` (without its language) in `l`.
fn page_in(cfg: Cfg, path: str, at: str, l: Lang) -> Resp | none {
    let r = file_resp(path) ?? { return none; };
    if !path.ends_with(".html") { return r; }
    let html = try str::from_utf8(r.body[0:r.body.len()]) catch _ { return r; };
    r.body = bytes_of(page_text(cfg, html, at, l));
    r
}

/// A page's markup with everything filled in (page_in).
fn page_text(cfg: Cfg, html: str, at: str, l: Lang) -> str {
    let local = lang::page(html, l).replace("<!--play:langs-->", lang::switch(at, l)).replace("<!--play:lang-menu-->", lang::menu(at, l)).replace("<!--play:packages-->", packages_note(cfg, l));
    stamp(cfg, fill(local.replace("og.png?v=dev", "og.png?v=" + cfg.og).replace("nabi dev →", f"nabi {cfg.release} →"), l))
}

/// The stylesheets and scripts a page names, as `"/x?v=<version>"`, so
/// a browser keeps each until it changes; the versions of the
/// highlighting's files (highlight.ts reads them from the meta); and
/// the examples the picker leaves out.
fn stamp(cfg: Cfg, html: str) -> str {
    let out = html;
    for p in ["/nabi.css", "/play.css", "/theme.js", "/play.js"] {
        if let x: Resp = asset(cfg, p) { out = out.replace(f"\"{p}\"", f"\"{p}?v={http::version(x.body)}\""); }
    }
    out.replace("<meta name=\"nabi-ts\" content=\"\">", f"<meta name=\"nabi-ts\" content=\"{cfg.ts}\">")
        .replace("<meta name=\"nabi-examples-off\" content=\"\">", f"<meta name=\"nabi-examples-off\" content=\"{chrome::esc(cfg.examples_off)}\">")
}

/// Cfg::ts, from static/ts/.
fn ts_versions() -> str {
    let ts: List<str> = List::new();
    for n in TS_FILES {
        if let x: Resp = file_resp("static/ts/" + n) { ts.push(f"{n}={http::version(x.body)}"); }
    }
    ts.join(",")
}

/// The highlighting's files under static/ts/ (highlight.ts).
const TS_FILES: [str; 3] = ["tree-sitter-nabi.wasm", "highlights.scm", "web-tree-sitter.wasm"];

/// A script that loads another by its address, with that address
/// versioned: play.js starts /run.js and /highlight.js, run.js imports
/// /nabi.mjs. A script's version then changes with what it loads.
fn chained(cfg: Cfg, p: str, x: Resp) -> Resp {
    let names: List<str> = if p == "/play.js" { ["/run.js", "/highlight.js"] } else if p == "/run.js" { ["/nabi.mjs"] } else { return x; };
    let body = try str::from_utf8(x.body[0:x.body.len()]) catch _ { return x; };
    for n in names {
        let dep = if n == "/nabi.mjs" { if cfg.mjs.is_empty() { none } else { file_resp(cfg.mjs) } } else { asset(cfg, n) };
        if let d: Resp = dep { body = body.replace(f"\"{n}\"", f"\"{n}?v={http::version(d.body)}\""); }
    }
    x.body = bytes_of(body);
    x
}

/// The file under `root` that canonical path `p` names, as a page.
fn site_file(cfg: Cfg, root: str, p: str) -> Resp | none {
    let f = http::page_file(root, p) ?? { return none; };
    page_resp(cfg, f)
}

/// The file at public path `p`: static/, then the kit and its fonts,
/// then PLAY_SITE.
fn asset(cfg: Cfg, p: str) -> Resp | none {
    // the TypeScript the page scripts are built from is not served
    let own: Resp | none = if kit::is_source(p.trim_start_matches("/")) { none } else { site_file(cfg, "static", p) };
    let x = own ?? kit_resp(p) ?? font_resp(p) ?? site_file(cfg, cfg.site, p) ?? { return none; };
    chained(cfg, p, x)
}

/// A file answer's caching: a file asked for by its current `?v=` for a
/// year; a page and anything else checked on every load (http::FRESH),
/// so a deploy shows at once while the CDN keeps them until its purge;
/// always an ETag of the content, and 304 when the client holds it.
fn cached(x: Resp, page: bool, r: Request) -> Resp {
    let tag = http::etag(x.body);
    // A page, and a file asked for without its current version: checked
    // on every load, so a deploy shows at once (http::FRESH). A file at
    // its current `?v=` never changes.
    let cc = if !page && http::is_current(r.query, x.body) { http::IMMUTABLE } else if r.path.starts_with("/fonts/") { http::FONTS } else { http::FRESH };
    // headers[1] is file_resp's and kit_resp's Cache-Control.
    x.headers[1] = cc;
    x.headers.push("ETag: " + tag);
    if http::not_modified(r, tag) { return Resp { status: 304, headers: [cc, "ETag: " + tag], body: List::new() }; }
    x
}

fn route(cfg: Cfg, s: TcpStream, r: Request) -> Resp {
    let p = r.path;
    if p == http::REPORT_PATH {
        if r.method != "POST" { return text(405, "POST only."); }
        if let line: str = http::csp_report(r.body) { eprintln(line); }
        return Resp { status: 204, headers: ["Cache-Control: no-store"], body: List::new() };
    }
    if p == "/api/compile" {
        if r.method != "POST" { return text(405, "POST the source to /api/compile."); }
        if !allow(client_of(s, r, cfg.client_header), cfg.rate) { return text(429, f"More than {cfg.rate} compiles a minute; wait a little."); }
        let opt = if r.query.contains("opt=2") { "2" } else { "0" };
        if r.body.trim().is_empty() { return text(400, "Nothing to compile."); }
        if r.body.len() > MAX_SOURCE { return too_large(); }
        if let why: str = refused(r.body) { return diagnostics(why); }
        return compile(cfg, r.body, opt);
    }
    if p == "/api/fmt" {
        if r.method != "POST" { return text(405, "POST the source to /api/fmt."); }
        if !allow(client_of(s, r, cfg.client_header), cfg.rate) { return text(429, f"More than {cfg.rate} requests a minute; wait a little."); }
        if r.body.trim().is_empty() { return text(400, "Nothing to format."); }
        if r.body.len() > MAX_SOURCE { return too_large(); }
        return format(cfg, r.body);
    }
    if p == "/api/share" {
        if r.method != "POST" { return text(405, "POST the source to /api/share."); }
        // Its own budget, apart from compiles.
        if !allow("share " + client_of(s, r, cfg.client_header), cfg.share_rate) { return text(429, f"More than {cfg.share_rate} links a minute; wait a little."); }
        if r.body.trim().is_empty() { return text(400, "Nothing to share."); }
        if r.body.len() > MAX_SOURCE { return too_large(); }
        return share(cfg, r.body);
    }
    if p == "/api/lsp" {
        if r.method != "POST" { return text(405, "POST a JSON request to /api/lsp."); }
        // Its own budget: the editor asks as the visitor types.
        if !allow("lsp " + client_of(s, r, cfg.client_header), cfg.lsp_rate) { return text(429, f"More than {cfg.lsp_rate} language requests a minute; wait a little."); }
        return language(cfg, r.body);
    }
    if r.method != "GET" && r.method != "HEAD" { return text(405, "Only GET here."); }
    if p == "/api/health" { return health(cfg); }
    if p == "/.well-known/security.txt" {
        return Resp { status: 200, headers: ["Content-Type: text/plain; charset=utf-8", http::FRESH], body: bytes_of(chrome::security_txt("https://playground.nabi-lang.org")) };
    }
    if p.starts_with("/api/share/") {
        let id = p["/api/share/".len():];
        if taken_down(cfg, id) { return gone_in(cfg, p, Lang::En); }
        let src = shared(cfg, id) ?? { return text(404, "No such link."); };
        return text(200, src);
    }
    if p.starts_with("/api/wasm/") { return wasm_by_key(cfg, p["/api/wasm/".len():]); }
    if p == "/nabi.mjs" && !cfg.mjs.is_empty() {
        if let f: Resp = file_resp(cfg.mjs) { return cached(f, false, r); }
    }
    if let c: str = url::canonical(p) {
        return Resp { status: 301, headers: [url::moved(c, r.query), "Cache-Control: public, max-age=3600"], body: List::new() };
    }
    let (l, at) = lang::split(p);
    if at.starts_with("/p/") {
        if taken_down(cfg, at[3:]) { return gone_in(cfg, p, l); }
        let src = shared(cfg, at[3:]) ?? { return not_found_in(cfg, p, l); };
        let x = shared_page(cfg, src, at, l) ?? { return not_found_in(cfg, p, l); };
        return cached(x, true, r);
    }
    if !l.is_en() {
        if at != "/" { return not_found_in(cfg, p, l); }
        let x = page_in(cfg, "static/index.html", "/", l) ?? { return not_found_in(cfg, p, l); };
        return cached(x, true, r);
    }
    if let x: Resp = asset(cfg, p) { return cached(x, x.headers[0].starts_with("Content-Type: text/html"), r); }
    not_found(cfg, p)
}

/// For uptime checks: 200 and `ok`, then the toolchain, the runner, the
/// sandbox and the packages, when programs can be built and run; else
/// 503 and why, in one line. It runs no compile (a probe that wants one
/// POSTs to /api/compile, scripts/probe.sh) and no counters: those stay
/// in the log.
fn health(cfg: Cfg) -> Resp {
    if cfg.mjs.is_empty() || !fs::exists(cfg.mjs) { return text(503, "no nabi.mjs: pages cannot run programs\n"); }
    let why = sandbox_down(cfg);
    if !why.is_empty() { return text(503, f"sandbox: {why}\n"); }
    let packages = if cfg.deps.is_empty() { "none" } else { cfg.packages };
    let sandbox = if words(cfg.wrap).is_empty() { "none" } else { "ok" };
    text(200, f"ok\nnabic {cfg.release}\nrun true\nsandbox {sandbox}\npackages {packages}\n")
}

/// The sandbox's last check: when, and why it failed ("" when it works).
struct Probe {
    at: i64;
    why: str;
}

static PROBES: Mutex<Dict<str, Probe>> = Mutex::new(Dict::new());

/// Seconds a sandbox check holds, so health probes cannot load the box.
const PROBE_TTL: i64 = 30i64;
/// Seconds `PLAY_WRAP --check` may take.
const PROBE_LIMIT: u64 = 5u64;

/// Why the sandbox cannot build, or "": `PLAY_WRAP --check` at most
/// once per PROBE_TTL, keyed by the wrap command. The lock is held
/// across the check, so probes that come meanwhile wait for its answer.
fn sandbox_down(cfg: Cfg) -> str {
    if words(cfg.wrap).is_empty() { return ""; }
    using g = PROBES.lock() {
        let d = g.get();
        let t = now_secs();
        let last = d.get(cfg.wrap) ?? Probe { at: t - PROBE_TTL, why: "" };
        if t - last.at < PROBE_TTL {
            last.why
        } else {
            let why = check_sandbox(cfg);
            d.insert(cfg.wrap, Probe { at: now_secs(), why: why });
            why
        }
    }
}

/// `PLAY_WRAP --check` (docker-sandbox.sh: Docker answers and has the
/// image; sandbox.sh: bwrap runs), in a directory of its own: "" when
/// it succeeds, else the first line it wrote, or why it did not finish.
fn check_sandbox(cfg: Cfg) -> str {
    let dir = cfg.work + "/check";
    try fs::create_dir_all(dir) catch e { return f"work directory: {e}"; };
    let log = try fs::create(dir + "/check.log") catch e { return f"work directory: {e}"; };
    let argv = words(cfg.wrap);
    argv.push("--check");
    let child = try sandboxed(Command::new(argv[0]).args(argv[1:argv.len()].to_list()).current_dir(dir), dir, PROBE_LIMIT)
        .stdin(Stdio::Null).stdout(Stdio::Null).stderr(Stdio::File(log)).kill_on_drop(true).spawn() catch e {
            return f"cannot start {argv[0]}: {e}";
        };
    let t0 = Instant::now();
    loop {
        let st = try child.try_wait() catch e { return f"{argv[0]}: {e}"; };
        if let s: std::process::ExitStatus = st {
            if s.success() { return ""; }
            let err = try fs::read_to_str(dir + "/check.log") catch _ { "" };
            let line = (err.trim().lines().next() ?? "").trim();
            return if line.is_empty() { "the check failed" } else { line };
        }
        if t0.elapsed().as_ms() > (PROBE_LIMIT as i64) * 1000i64 {
            try child.kill() catch _ {};
            try child.wait() catch _ {};
            return f"no answer in {PROBE_LIMIT} s";
        }
        thread::sleep(Duration::ms(25));
    }
}

/// 404: the page with the site's chrome, or plain text under /api/.
fn not_found(cfg: Cfg, p: str) -> Resp { not_found_in(cfg, p, Lang::En) }

fn not_found_in(cfg: Cfg, p: str, l: Lang) -> Resp {
    if !p.starts_with("/api/") {
        if let x: Resp = page_in(cfg, "static/404.html", "/", l) {
            x.status = 404;
            return x;
        }
    }
    text(404, "Not found.")
}

fn handle(s: TcpStream, cfg: Cfg) {
    let t0 = Instant::now();
    let r = try http::read_request(s, MAX_BODY, Duration::secs(10)) catch e {
        try http::send(s, e.status, ["Content-Type: text/plain; charset=utf-8"], e.msg + "\n", false) catch _ {};
        try s.close() catch _ {};
        return;
    };
    let resp = route(cfg, s, r);
    // http::send writes a 304 without a body or Content-Length.
    try http::send(s, resp.status, resp.headers, resp.body, r.method == "HEAD") catch _ {};
    try s.close() catch _ {};
    eprintln(f"{r.method} {r.path} {resp.status} {resp.body.len()}B {t0.elapsed().as_ms()}ms");
}

fn main() throws {
    let cfg = try load_cfg();
    // Without a sandbox a program could read the server's files at
    // compile time: only this machine may ask then.
    if cfg.wrap.is_empty() && !cfg.addr.starts_with("127.0.0.1:") && !cfg.addr.starts_with("[::1]:") && !cfg.addr.starts_with("localhost:") {
        eprintln(f"error: PLAY_ADDR={cfg.addr} is reachable from other machines, so PLAY_WRAP must name a sandbox (scripts/sandbox.sh, see README.md)");
        process::exit(2);
    }
    try fs::create_dir_all(cfg.work + "/jobs");
    // Without a writable share directory, Share falls back to #code links.
    try fs::create_dir_all(cfg.shares) catch e { eprintln(f"note: share links off: {cfg.shares}: {e}"); };
    SHARES.store(count_shares(cfg.shares));
    if cfg.mjs.is_empty() || !fs::exists(cfg.mjs) {
        eprintln(f"note: no nabi.mjs (PLAY_MJS): pages cannot run programs");
    }
    using l = try net::tcp_listen(cfg.addr) {
        eprintln(f"playground on http://{cfg.addr}, compiling with {cfg.nabic} ({cfg.jobs} at a time, {cfg.timeout} s each)");
        for c in l.incoming().results() {
            let s = try c.get() catch e {
                eprintln(f"accept: {e}");
                continue;
            };
            if ACTIVE.fetch_add(1i64) >= MAX_CONNS {
                ACTIVE.fetch_sub(1i64);
                try http::send(s, 503, ["Content-Type: text/plain; charset=utf-8", "Retry-After: 5"], "busy\n", false) catch _ {};
                try s.close() catch _ {};
                continue;
            }
            let t = thread::spawn(|| {
                handle(s, cfg);
                ACTIVE.fetch_sub(1i64);
                0
            });
            t.detach();
        }
    }
}

#[cfg(test)]
fn expect(ok: bool, what: str) {
    if !ok { panic(what); }
}

#[cfg(test)]
fn body_of(r: Resp) -> str { try str::from_utf8(r.body[0:r.body.len()]) catch _ { "" } }

/// A failed compile answers 200 with the diagnostics and their header;
/// a 4xx would log a failed request in every visitor's console.
#[test]
fn compile_errors_are_answers() {
    let work = f"{env::temp_dir()}/nabi-playground-test-{std::process::id()}";
    try fs::create_dir_all(work + "/jobs") catch e { panic(f"{e}"); };
    // A stand-in nabic, run by the wrap command so it needs no exec bit.
    try fs::write(work + "/nabic.sh", "echo 'error: boom' >&2\nexit 1\n") catch e { panic(f"{e}"); };
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: work + "/nabic.sh", nabi: work + "/nabic.sh", site: "", mjs: "", wrap: "/bin/sh", work: work, jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: work + "/shares", share_rate: 10, share_max: 2, og: "0123456789", release: "9.9.9" };
    let r = compile(cfg, "fn main() {}\n", "0");
    try fs::remove_dir_all(work) catch _ {};
    expect(r.status == 200, "status");
    expect(r.headers.contains("X-Nabi-Diagnostics: 1"), "header");
    expect(body_of(r).contains("error: boom"), "body");

    let no = diagnostics(refused("const S: str = include_str!(\"/etc/passwd\");") ?? "");
    expect(no.status == 200 && no.headers.contains("X-Nabi-Diagnostics: 1"), "refused");
    expect(body_of(no).contains("include_str!"), "refused body");
    expect(text(429, "slow down").headers.len() == 2, "real errors keep their status, no header");

    let page = page_resp(cfg, "static/index.html") ?? panic("no index.html");
    expect(body_of(page).contains("og.png?v=0123456789") && !body_of(page).contains("v=dev"), "og version in page");
    expect(body_of(page).contains("nabi 9.9.9 → wasm32") && !body_of(page).contains("nabi dev"), "toolchain release in page");
    expect(!body_of(page).contains("<!--web:"), "shared markup filled in");
    expect(body_of(page).contains("data-theme-set=\"dark\"") && body_of(page).contains("<a href=\"/\" aria-current=\"page\">Playground</a>"), "footer");
    let css = kit_resp("/nabi.css") ?? panic("no /nabi.css");
    expect(css.headers[0] == "Content-Type: text/css; charset=utf-8" && css.body.len() > 0, "kit file");
    expect(kit_resp("/theme.js") is Resp && kit_resp("/play.js") is none, "kit names only");
    expect(body_of(page).contains("class=\"seg\"") && body_of(page).contains("class=\"social\""), "menu");
    expect(body_of(page).contains("<nav class=\"nav sites\"") && body_of(page).contains("<span>MIT OR Apache-2.0</span> · <span>© 2026"), "header sites, credits");

    let lost = not_found(cfg, "/nope");
    expect(lost.status == 404 && body_of(lost).contains("Back to the playground") && body_of(lost).contains("<div class=\"lost\">") && !body_of(lost).contains("<!--web:"), "404 page");
    expect(not_found(cfg, "/api/nope").status == 404 && body_of(not_found(cfg, "/api/nope")) == "Not found.", "404 api");
    expect(body_of(page).contains("<h1 class=\"sr-only\">Nabi Playground</h1>"), "h1");
}

/// Files carry an ETag and answer 304 for it; a file asked for by its
/// current ?v= is cached for good, a page for minutes, the rest revalidated.
#[test]
fn caching() {
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: "", nabi: "", site: "", mjs: "", wrap: "", work: "", jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: "", share_rate: 10, share_max: 2, og: "dev", release: "dev" };
    // GET `target`, holding If-None-Match `inm` when not empty.
    let get = |target: str, inm: str| {
        let h = if inm.is_empty() { "" } else { "\r\nIf-None-Match: " + inm };
        try http::parse_head(f"GET {target} HTTP/1.1\r\nHost: a{h}") catch e { panic(e.msg) }
    };
    let page = page_resp(cfg, "static/index.html") ?? panic("no index.html");
    let js = asset(cfg, "/play.js") ?? panic("no play.js");
    let v = http::version(js.body);
    expect(body_of(page).contains(f"src=\"/play.js?v={v}\""), "stamped play.js");
    expect(!body_of(page).contains("href=\"/nabi.css\"") && !body_of(page).contains("href=\"/play.css\"") && !body_of(page).contains("src=\"/theme.js\""), "stamped css, theme.js");
    let c = cached(asset(cfg, "/play.js") ?? panic("js"), false, get(f"/play.js?v={v}", ""));
    expect(c.status == 200 && c.headers.contains("Cache-Control: public, max-age=31536000, immutable"), "immutable");
    let etag = c.headers[c.headers.len() - 1];
    expect(etag.starts_with("ETag: \"") && etag.len() == 24, "etag");
    let stale = cached(asset(cfg, "/play.js") ?? panic("js"), false, get("/play.js?v=0000000000", ""));
    expect(stale.headers.contains(http::FRESH), "stale version revalidates");
    let p = cached(page, true, get("/", ""));
    expect(p.headers.contains(http::FRESH), "page: checked on every load");
    // play.js names /run.js and /highlight.js by their versions.
    let run = asset(cfg, "/run.js") ?? panic("no run.js");
    let hl = asset(cfg, "/highlight.js") ?? panic("no highlight.js");
    expect(body_of(js).contains(f"\"/run.js?v={http::version(run.body)}\"") && body_of(js).contains(f"\"/highlight.js?v={http::version(hl.body)}\""), "chained versions");
    expect(ts_versions().contains("tree-sitter-nabi.wasm=") && ts_versions().contains("highlights.scm="), "ts versions");
    let tag = etag["ETag: ".len():];
    let again = cached(asset(cfg, "/play.js") ?? panic("js"), false, get("/play.js", "W/" + tag + ", \"x\""));
    expect(again.status == 304 && again.body.len() == 0 && again.headers.contains("ETag: " + tag), "304");
    expect(cached(asset(cfg, "/play.js") ?? panic("js"), false, get("/play.js", "\"nope\"")).status == 200, "other etag");
    let font = asset(cfg, "/fonts/Geist-Variable.woff2") ?? panic("no font");
    expect(font.headers[0] == "Content-Type: font/woff2", "font type");
    expect(cached(font, false, get("/fonts/Geist-Variable.woff2", "")).headers.contains(http::FONTS), "font: kept a year");
    expect((asset(cfg, "/fonts/pretendard.css") ?? panic("no pretendard.css")).headers[0] == "Content-Type: text/css; charset=utf-8", "pretendard.css");
    expect(asset(cfg, "/fonts/README.md") is none && asset(cfg, "/fonts/../nabi/nabi.nabion") is none, "fonts only");
    expect(body_of(page).contains("<link rel=\"preload\" href=\"/fonts/Geist-Variable.woff2\"") && !body_of(page).contains("googleapis") && !body_of(page).contains("jsdelivr"), "own fonts");
}

/// Share links: content-addressed, never rewritten, strict ids, a cap.
#[test]
fn share_links() {
    let work = f"{env::temp_dir()}/nabi-playground-share-{std::process::id()}";
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: "", nabi: "", site: "", mjs: "", wrap: "", work: work, jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: work + "/shares", share_rate: 10, share_max: 2, og: "dev", release: "dev" };
    SHARES.store(0i64);
    let a = share(cfg, "fn main() {}\n");
    let id = body_of(a);
    expect(a.status == 200 && valid_id(id) && id == share_id("fn main() {}\n"), "stored");
    expect(body_of(share(cfg, "fn main() {}\n")) == id && SHARES.load() == 1i64, "same code, same id, one file");
    expect((shared(cfg, id) ?? "") == "fn main() {}\n", "read back");
    expect(shared(cfg, "../shares/" + id) is none && shared(cfg, id + "x") is none && shared(cfg, "ABCDEFGHIJ") is none && shared(cfg, "abcdefgh1j") is none, "bad ids");
    expect(shared(cfg, "aaaaaaaaaa") is none, "unknown id");
    let x = shared_page(cfg, "</pre><script>alert(1)</script>", "/p/" + id, Lang::En) ?? panic("page");
    expect(body_of(x).contains("<pre id=\"shared\" hidden>\n&lt;/pre&gt;&lt;script&gt;") && body_of(x).contains("noindex"), "escaped in the page");
    // A different code under an existing id is refused, not overwritten.
    try fs::write(cfg.shares + "/" + share_id("x") + ".nabi", "y") catch e { panic(f"{e}"); };
    expect(share(cfg, "x").status == 409 && (shared(cfg, share_id("x")) ?? "") == "y", "collision");
    expect(share(cfg, "fn other() {}\n").status == 200 && share(cfg, "fn third() {}\n").status == 503, "cap");
    expect(count_shares(cfg.shares) == 3i64, "count");
    try fs::remove_dir_all(work) catch _ {};
}

/// A compile past its time is stopped, and so is its sandbox: the wrap
/// command gets `--kill` in the job directory.
#[test]
fn timeouts_stop_the_sandbox() {
    let work = f"{env::temp_dir()}/nabi-playground-kill-{std::process::id()}";
    try fs::create_dir_all(work + "/jobs") catch e { panic(f"{e}"); };
    try fs::write(work + "/wrap.sh", f"if [ \"$1\" = --kill ]; then echo \"$PLAY_LIMIT\" > {work}/killed; exit 0; fi\nexec /bin/sh \"$@\"\n") catch e { panic(f"{e}"); };
    try fs::write(work + "/slow.sh", "sleep 5\n") catch e { panic(f"{e}"); };
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: work + "/slow.sh", nabi: "", site: "", mjs: "", wrap: "/bin/sh " + work + "/wrap.sh", work: work, jobs: 1, timeout: 1u64, rate: 30, client_header: "", shares: "", share_rate: 10, share_max: 2, og: "dev", release: "dev" };
    let r = compile(cfg, "fn main() {}\n", "0");
    let killed = try fs::read_to_str(work + "/killed") catch _ { "" };
    try fs::remove_dir_all(work) catch _ {};
    expect(r.status == 504, f"status {r.status}");
    expect(killed.trim() == "1", f"wrap --kill ran with the limit: `{killed}`");
}

/// Packages: nabic gets the prebuilt ones only for a program that names
/// one, all of them in order, for the build's level.
#[test]
fn package_externs() {
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: "", nabi: "", site: "", mjs: "", wrap: "", work: "", jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: "", share_rate: 10, share_max: 2, og: "dev", release: "dev", deps: "/d", packages: "linalg, spec=special,stats,plot" };
    expect(externs(cfg, "fn main() {}\n", "0").is_empty(), "a plain program");
    let x = externs(cfg, "fn main() { println(stats::mean([1.0])); }\n", "2");
    expect(x.join(" ") == "--extern linalg=/d/release/deps/linalg.nabihir --extern spec=/d/release/deps/special.nabihir --extern stats=/d/release/deps/stats.nabihir --extern plot=/d/release/deps/plot.nabihir", x.join(" "));
    expect(externs(cfg, "use plot;\n", "0")[1] == "linalg=/d/debug/deps/linalg.nabihir", "debug");
    cfg.deps = "";
    expect(externs(cfg, "use plot;\n", "0").is_empty(), "no PLAY_DEPS");
}

/// Format answers the file `nabi fmt` left, or its diagnostics.
#[test]
fn format_answers() {
    let work = f"{env::temp_dir()}/nabi-playground-fmt-{std::process::id()}";
    try fs::create_dir_all(work + "/jobs") catch e { panic(f"{e}"); };
    try fs::write(work + "/ok.sh", "printf 'fn main() {\\n    f();\\n}\\n' > main.nabi\n") catch e { panic(f"{e}"); };
    try fs::write(work + "/bad.sh", "echo 'error[E001]: <fmt>:2:1: unterminated string literal' >&2\nexit 1\n") catch e { panic(f"{e}"); };
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: "", nabi: work + "/ok.sh", site: "", mjs: "", wrap: "/bin/sh", work: work, jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: work + "/shares", share_rate: 10, share_max: 2, og: "dev", release: "dev" };
    let ok = format(cfg, "fn main() {\nf();\n}\n");
    cfg.nabi = work + "/bad.sh";
    let bad = format(cfg, "fn main() {\n\"\n");
    try fs::remove_dir_all(work) catch _ {};
    expect(ok.status == 200 && !ok.headers.contains("X-Nabi-Diagnostics: 1") && body_of(ok) == "fn main() {\n    f();\n}\n", "formatted");
    expect(bad.status == 200 && bad.headers.contains("X-Nabi-Diagnostics: 1") && body_of(bad).contains("main.nabi:2:1"), "fmt diagnostics");
}

/// Only code is refused: a comment or a string naming include_str! is
/// a program like any other.
#[test]
fn refusals_read_code_only() {
    expect(refused("fn main() { let s = include_str!(\"/etc/passwd\"); }") is str, "call");
    expect(refused("fn main() { let s = include_bytes ! (\"x\"); }") is str, "spaced");
    expect(refused("#[path = \"/etc\"]\nmod m;") is str && refused("# [ path = \"x\" ]\nmod m;") is str, "path");
    expect(refused("use wit :: import;") is str, "wit");
    expect(refused("// include_str! is refused here\nfn main() {}\n") is none, "line comment");
    expect(refused("/* include_bytes /* nested */ #[path */ fn main() {}") is none, "block comment");
    expect(refused("fn main() { println(\"no include_str here\"); }") is none, "string");
    expect(refused("fn main() { println(r#\"include_str \"quoted\" #[path\"#); }") is none, "raw string");
    expect(refused("fn main() { let c = '\"'; let s = \"include_str\"; }") is none, "char quote");
    expect(refused("fn main() { println(f\"{include_str!(\"x\")}\"); }") is str, "f-string code");
    expect(refused("fn main() { let my_include_str = 1; }") is none, "longer identifier");
}

/// The module cache drops its least recently used quarter when full.
#[test]
fn cache_evicts_least_recent() {
    let dir = f"{env::temp_dir()}/nabi-playground-lru-{std::process::id()}";
    try fs::create_dir_all(dir) catch e { panic(f"{e}"); };
    for k in 0..8 {
        try fs::write(f"{dir}/{k}.wasm", "x") catch e { panic(f"{e}"); };
        thread::sleep(Duration::ms(15));
    }
    // 0 is used again: newest now.
    try fs::write(f"{dir}/0.wasm", "x") catch e { panic(f"{e}"); };
    make_room(dir, 8);
    let left = fs::exists(f"{dir}/0.wasm") && !fs::exists(f"{dir}/1.wasm") && !fs::exists(f"{dir}/2.wasm") && fs::exists(f"{dir}/3.wasm");
    make_room(dir, 8);
    let n = 0usize;
    for _ in (try fs::read_dir(dir) catch e { panic(f"{e}"); }).results() { n += 1; }
    try fs::remove_dir_all(dir) catch _ {};
    expect(left, "the oldest two went (8 - 8 + 8 / 4), the reused one stayed");
    expect(n == 6, f"under the limit nothing goes: {n}");
}

/// /ko, /zh-hans and /zh-hant are the page in Korean and Chinese: its
/// chrome, its switch back, its 404.
#[test]
fn translated_pages() {
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: "", nabi: "", site: "", mjs: "", wrap: "", work: "", jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: "", share_rate: 10, share_max: 2, og: "dev", release: "dev", deps: "/d", packages: "json,spec=special,stats" };
    let en = body_of(page_resp(cfg, "static/index.html") ?? panic("en"));
    let ko = body_of(page_in(cfg, "static/index.html", "/", Lang::Ko) ?? panic("ko"));
    expect(en.contains("<html lang=\"en\"") && en.contains("href=\"/ko\" hreflang=\"ko\"") && en.contains("Official packages are ready to use: <a href=\"https://packages.nabi-lang.org/packages/json\">json</a>, <a href=\"https://packages.nabi-lang.org/packages/stats\">stats</a>."), "en page");
    expect(ko.contains("<html lang=\"ko\"") && ko.contains(">공유<") && ko.contains("<a href=\"/\" hreflang=\"en\"") && ko.contains("플레이그라운드</a>") && ko.contains("pretendard"), "ko page");
    expect(ko.contains("<link rel=\"canonical\" href=\"https://playground.nabi-lang.org/ko\">") && ko.contains("hreflang=\"en\" href=\"https://playground.nabi-lang.org/\""), "ko addresses");
    let p = body_of(page_in(cfg, "static/index.html", "/p/abcdefghij", Lang::Ko) ?? panic("ko p"));
    expect(p.contains("href=\"/p/abcdefghij\" hreflang=\"en\""), "a share's switch");
    let lost = not_found_in(cfg, "/ko/nope", Lang::Ko);
    expect(lost.status == 404 && body_of(lost).contains("플레이그라운드로 돌아가기") && body_of(lost).contains("<html lang=\"ko\""), "ko 404");
    let hans = body_of(page_in(cfg, "static/index.html", "/", Lang::ZhHans) ?? panic("zh-Hans"));
    let hant = body_of(page_in(cfg, "static/index.html", "/p/abcdefghij", Lang::ZhHant) ?? panic("zh-Hant"));
    expect(hans.contains("<html lang=\"zh-Hans\"") && hans.contains("</svg>运行</button>") && hans.contains("可以直接使用以下官方包：<a href=\"https://packages.nabi-lang.org/packages/json\">json</a>、<a") && hans.contains("https://nabi-lang.org/zh-hans/privacy") && hans.contains("<link rel=\"canonical\" href=\"https://playground.nabi-lang.org/zh-hans\">") && !hans.contains("pretendard"), "zh-Hans page");
    expect(hant.contains("<html lang=\"zh-Hant\"") && hant.contains("</svg>執行</button>") && hant.contains("官方套件") && hant.contains("href=\"/zh-hans/p/abcdefghij\" hreflang=\"zh-Hans\"") && hant.contains("hreflang=\"zh-Hant\" href=\"https://playground.nabi-lang.org/zh-hant\"") && hant.contains("https://docs.nabi-lang.org/latest/zh-hant\""), "zh-Hant share page");
    for (l, code) in [(Lang::ZhHans, "zh-Hans"), (Lang::ZhHant, "zh-Hant")] {
        let nf = not_found_in(cfg, "/" + l.slug() + "/nope", l);
        expect(nf.status == 404 && body_of(nf).contains(f"<html lang=\"{code}\"") && body_of(nf).contains(l.words().not_found) && body_of(nf).contains("返回 Playground"), code);
    }
    cfg.deps = "";
    expect(!body_of(page_resp(cfg, "static/index.html") ?? panic("en")).contains("Official packages"), "no packages, no list");
}

/// The picker leaves out the examples whose packages are not here.
#[test]
fn examples_need_their_packages() {
    expect(examples_off("/d", PACKAGES) == "", examples_off("/d", PACKAGES));
    expect(examples_off("/d", "json,spec=special,stats") == "linalg,plot,units", examples_off("/d", "json,spec=special,stats"));
    expect(examples_off("", PACKAGES) == "json,linalg,plot,stats,units", examples_off("", PACKAGES));
    expect(uses("use plot;", "plot") && uses("x = stats::mean(a)", "stats") && uses("#[derive(json::Json)]", "json"), "uses");
    expect(!uses("let plots = 1; myplot::x(); std::plot::y(); plot(1);", "plot"), "not uses");
    expect(!uses(code_only("// table::x\nlet s = \"table::\";"), "table"), "comments and strings");
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: "", nabi: "", site: "", mjs: "", wrap: "", work: "", jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: "", share_rate: 10, share_max: 2, og: "dev", release: "dev", examples_off: "linalg,plot" };
    expect(body_of(page_resp(cfg, "static/index.html") ?? panic("page")).contains("<meta name=\"nabi-examples-off\" content=\"linalg,plot\">"), "stamped");
}

/// /api/health says ok and what is there, or 503 and why in one line;
/// the sandbox's check is cached.
#[test]
fn health_answers() {
    let work = f"{env::temp_dir()}/nabi-playground-health-{std::process::id()}";
    try fs::create_dir_all(work) catch e { panic(f"{e}"); };
    try fs::write(work + "/nabi.mjs", "") catch e { panic(f"{e}"); };
    try fs::write(work + "/up.sh", "[ \"$1\" = --check ] && echo ran >> ../ran\n") catch e { panic(f"{e}"); };
    try fs::write(work + "/down.sh", "echo \"no image x\" >&2\necho more >&2\nexit 1\n") catch e { panic(f"{e}"); };
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: "", nabi: "", site: "", mjs: work + "/nabi.mjs", wrap: "", work: work, jobs: 3, timeout: 20u64, rate: 30, client_header: "", shares: "", share_rate: 10, share_max: 2, og: "dev", release: "9.9.9" };
    let ok = health(cfg);
    cfg.wrap = "/bin/sh " + work + "/up.sh";
    let up = health(cfg);
    let again = health(cfg);
    let ran = try fs::read_to_str(work + "/ran") catch _ { "" };
    cfg.wrap = "/bin/sh " + work + "/down.sh";
    let down = health(cfg);
    // a fixed sandbox shows after the cache's time, not at once
    try fs::write(work + "/down.sh", "exit 0\n") catch e { panic(f"{e}"); };
    let still = health(cfg);
    cfg.mjs = "";
    let no = health(cfg);
    try fs::remove_dir_all(work) catch _ {};
    expect(ok.status == 200 && body_of(ok) == "ok\nnabic 9.9.9\nrun true\nsandbox none\npackages none\n", body_of(ok));
    expect(up.status == 200 && body_of(up).contains("sandbox ok") && again.status == 200, body_of(up));
    expect(ran == "ran\n", f"checked once: `{ran}`");
    expect(down.status == 503 && body_of(down) == "sandbox: no image x\n", body_of(down));
    expect(still.status == 503, "cached");
    expect(no.status == 503 && body_of(no) == "no nabi.mjs: pages cannot run programs\n", "no runner");
}

/// The rate limit keeps IPv4 clients apart and an IPv6 /64 together.
#[test]
fn rate_keys() {
    expect(rate_key("203.0.113.7") == "203.0.113.7", "ipv4");
    expect(rate_key("2001:db8:1:2:3:4:5:6") == "2001:db8:1:2::/64", rate_key("2001:db8:1:2:3:4:5:6"));
    expect(rate_key("2001:DB8:0001:0002:aaaa::1") == "2001:db8:1:2::/64", "case, leading zeros");
    expect(rate_key("2001:db8::1") == "2001:db8:0:0::/64" && rate_key("2001:db8:0:0:ffff::9") == "2001:db8:0:0::/64", "compressed");
    expect(rate_key("2001:db8:1::") == "2001:db8:1:0::/64" && rate_key("::1") == "0:0:0:0::/64" && rate_key("::") == "0:0:0:0::/64", "edges");
    expect(rate_key("[2001:db8:1:2::5]") == "2001:db8:1:2::/64" && rate_key("fe80::1%en0") == "fe80:0:0:0::/64", "brackets, zone");
    expect(rate_key("::ffff:198.51.100.2") == "198.51.100.2", "mapped ipv4");
    expect(rate_key("64:ff9b::198.51.100.2") == "64:ff9b:0:0::/64", "embedded ipv4");
    expect(rate_key("2001:db8:1:2:3:4:5:6") != rate_key("2001:db8:1:3:3:4:5:6"), "other /64");
    expect(rate_key("1::2::3") == "1::2::3" && rate_key("2001:db8:xyz::1") == "2001:db8:xyz::1" && rate_key("1:2:3") == "1:2:3" && rate_key("?") == "?", "unparsable as given");
}

/// /api/lsp runs nabils under the wrap, the session on its stdin, and
/// answers its reply, cached; a bad request says what to send.
#[test]
fn language_requests() {
    let work = f"{env::temp_dir()}/nabi-playground-lsp-{std::process::id()}";
    try fs::create_dir_all(work + "/jobs") catch e { panic(f"{e}"); };
    let reply = f"{{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{{\"uri\":\"{lsp::URI}\",\"range\":{{}}}}}}";
    try fs::write(work + "/reply", f"Content-Length: {reply.len()}\r\n\r\n{reply}") catch e { panic(f"{e}"); };
    try fs::write(work + "/nabils.sh", f"echo ran >> {work}/ran\ncat > {work}/got\necho 'a note' >&2\ncat {work}/reply\n") catch e { panic(f"{e}"); };
    try fs::write(work + "/mute.sh", "cat > /dev/null\necho 'nabils: cannot run nabi' >&2\nexit 1\n") catch e { panic(f"{e}"); };
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: "", nabi: "", nabils: work + "/nabils.sh", site: "", mjs: "", wrap: "/bin/sh", work: work, jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: "", share_rate: 10, share_max: 2, og: "dev", release: "lsp-test" };
    let ask = "{\"code\":\"fn main() {}\\n\",\"request\":\"definition\",\"line\":0,\"character\":3}";
    let a = language(cfg, ask);
    let b = language(cfg, ask);
    let got = try fs::read_to_str(work + "/got") catch _ { "" };
    let ran = try fs::read_to_str(work + "/ran") catch _ { "" };
    let bad = language(cfg, "fn main() {}");
    cfg.nabils = work + "/mute.sh";
    let mute = language(cfg, "{\"code\":\"x\",\"request\":\"hover\",\"line\":0,\"character\":0}");
    try fs::remove_dir_all(work) catch _ {};
    expect(a.status == 200 && body_of(a) == "{\"result\":{\"uri\":\"main.nabi\",\"range\":{}}}" && a.headers.contains("Content-Type: application/json") && a.headers.contains("X-Nabi-Cache: miss"), body_of(a));
    expect(b.status == 200 && b.headers.contains("X-Nabi-Cache: hit") && ran == "ran\n", f"cached: `{ran}`");
    expect(got.contains("\"method\":\"textDocument/definition\"") && got.contains("\"text\":\"fn main() {}\\n\"") && got.ends_with("\"method\":\"exit\"}"), got);
    expect(bad.status == 400 && body_of(bad).contains("send a JSON object"), body_of(bad));
    expect(mute.status == 502 && body_of(mute).contains("works without it"), body_of(mute));
}

/// A compile names its module's key, and GET /api/wasm/<key> serves the
/// cached module for good; a shared page names the keys it has.
#[test]
fn modules_by_key() {
    let work = f"{env::temp_dir()}/nabi-playground-wasm-{std::process::id()}";
    try fs::create_dir_all(work + "/jobs") catch e { panic(f"{e}"); };
    try fs::write(work + "/nabic.sh", "printf '\\0asm' > main.wasm\n") catch e { panic(f"{e}"); };
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: work + "/nabic.sh", nabi: "", site: "", mjs: "", wrap: "/bin/sh", work: work, jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: "", share_rate: 10, share_max: 2, og: "dev", release: "wasm-test" };
    let src = "fn main() {}\n";
    let c = compile(cfg, src, "0");
    let key = module_key(cfg, src, "0");
    let got = wasm_by_key(cfg, key);
    let page = body_of(shared_page(cfg, src, "/p/abcdefghij", Lang::En) ?? panic("page"));
    let missing = wasm_by_key(cfg, module_key(cfg, src, "2"));
    try fs::remove_dir_all(work) catch _ {};
    expect(c.status == 200 && c.headers.contains("X-Nabi-Module: " + key) && c.headers.contains("X-Nabi-Cache: miss"), "compile names its key");
    expect(got.status == 200 && got.body.len() == 4 && got.headers.contains(http::IMMUTABLE) && got.headers[0] == "Content-Type: application/wasm", "by key");
    expect(missing.status == 404 && body_of(missing).contains("POST the source"), body_of(missing));
    expect(wasm_by_key(cfg, "../cache/x").status == 404 && wasm_by_key(cfg, key.to_uppercase()).status == 404, "bad keys");
    expect(page.contains(f"<pre id=\"shared\" hidden data-wasm0=\"{key}\">") && !page.contains("data-wasm2"), "shared page names the cached key");
}

/// A share in PLAY_TAKEDOWN answers 410, and the list is read again
/// when it changes.
#[test]
fn takedowns() {
    let work = f"{env::temp_dir()}/nabi-playground-takedown-{std::process::id()}";
    try fs::create_dir_all(work + "/shares") catch e { panic(f"{e}"); };
    let cfg = Cfg { addr: "127.0.0.1:0", nabic: "", nabi: "", site: "", mjs: "", wrap: "", work: work, jobs: 1, timeout: 20u64, rate: 30, client_header: "", shares: work + "/shares", share_rate: 10, share_max: 10, og: "dev", release: "dev", takedown: work + "/takedown" };
    let reset = || { using g = TAKEDOWN.lock() { g.set(Takedown { checked: 0i64, stamp: "", ids: Dict::new() }); } };
    let id = body_of(share(cfg, "fn bad() {}\n"));
    reset();
    expect(!taken_down(cfg, id), "no file: nothing taken down");
    try fs::write(cfg.takedown, f"# a comment\n\nhttps://playground.nabi-lang.org/p/{id}  # reported\nnot-an-id\n") catch e { panic(f"{e}"); };
    reset();
    let down = taken_down(cfg, id);
    let again = share(cfg, "fn bad() {}\n");
    let page = gone_in(cfg, "/p/" + id, Lang::En);
    let ko = gone_in(cfg, "/ko/p/" + id, Lang::Ko);
    let zh = gone_in(cfg, "/zh-hant/p/" + id, Lang::ZhHant);
    let api = gone_in(cfg, "/api/share/" + id, Lang::En);
    try fs::write(cfg.takedown, "\n") catch e { panic(f"{e}"); };
    reset();
    let back = taken_down(cfg, id);
    try fs::remove_dir_all(work) catch _ {};
    reset();
    expect(down && !taken_down(cfg, "aaaaaaaaaa"), "listed by its link");
    expect(again.status == 410, "no new short link for it");
    expect(page.status == 410 && body_of(page).contains("Link removed") && body_of(page).contains("mailto:privacy@nabi-lang.org") && body_of(page).contains("<title>Link removed · Nabi Playground</title>") && !body_of(page).contains("<!--web:"), "the page");
    expect(ko.status == 410 && body_of(ko).contains("내려진 링크") && body_of(ko).contains("<html lang=\"ko\""), "the Korean page");
    expect(zh.status == 410 && body_of(zh).contains("連結已撤下") && body_of(zh).contains("<html lang=\"zh-Hant\""), "the Chinese page");
    expect(api.status == 410 && body_of(api) == "This link was taken down.", "plain under /api/");
    expect(!back, "read again on change");
}
