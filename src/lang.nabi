// The page in Korean: `/ko`, `/ko/p/<id>` and the 404s under /ko/ are
// static/index.html and static/404.html with each English piece below
// replaced, longest first where one holds another. The script's own
// words are in static/ui/text.ts.

/// The language of request path `p` and the path in it: `/ko` is `/`
/// in Korean, `/ko/p/x` is `/p/x`.
pub fn split(p: str) -> (bool, str) {
    if p == "/ko" { return (true, "/"); }
    if let rest: str = p.strip_prefix("/ko/") { return (true, "/" + rest); }
    (false, p)
}

/// Path `p` (`/`, `/p/x`) as a page of the language `ko` says.
pub fn path_in(p: str, ko: bool) -> str {
    if !ko { return p; }
    if p == "/" { "/ko" } else { "/ko" + p }
}

/// The menu's English / Korean switch for the page at `p` (without
/// /ko); the script carries the address's #fragment over.
pub fn switch(p: str, ko: bool) -> str {
    let en = if ko { f"<a href=\"{path_in(p, false)}\" hreflang=\"en\" lang=\"en\" data-lang>English</a>" } else { "<span aria-current=\"true\" lang=\"en\">English</span>" };
    let kr = if ko { "<span aria-current=\"true\" lang=\"ko\">한국어</span>" } else { f"<a href=\"{path_in(p, true)}\" hreflang=\"ko\" lang=\"ko\" data-lang>한국어</a>" };
    let label = if ko { "언어" } else { "Language" };
    f"<nav class=\"langs\" aria-label=\"{label}\">{en}{kr}</nav>"
}

/// `html` in Korean when `ko`.
pub fn page(html: str, ko: bool) -> str {
    if !ko { return html; }
    let out = html;
    for (en, kr) in PIECES { out = out.replace(en, kr); }
    out
}

/// English piece, Korean piece.
pub const PIECES: [(str, str); 40] = [
    ("<html lang=\"en\"", "<html lang=\"ko\""),
    ("content=\"en_US\"", "content=\"ko_KR\""),
    ("<title>Not found · Nabi Playground</title>", "<title>찾을 수 없음 · Nabi 플레이그라운드</title>"),
    ("<title>Nabi Playground</title>", "<title>Nabi 플레이그라운드</title>"),
    ("content=\"Nabi Playground\"", "content=\"Nabi 플레이그라운드\""),
    ("<h1 class=\"sr-only\">Nabi Playground</h1>", "<h1 class=\"sr-only\">Nabi 플레이그라운드</h1>"),
    ("content=\"Write Nabi in the browser and run it: the server compiles it to WebAssembly, your browser runs it.\"", "content=\"브라우저에서 Nabi 코드를 쓰고 실행합니다. 서버가 WebAssembly로 컴파일하고 브라우저가 실행합니다.\""),
    ("content=\"Write Nabi in the browser and run it.\"", "content=\"브라우저에서 Nabi 코드를 쓰고 실행합니다.\""),
    ("content=\"Nabi Playground: write Nabi in the browser and run it\"", "content=\"Nabi 플레이그라운드: 브라우저에서 Nabi 코드를 쓰고 실행합니다\""),
    ("<link rel=\"canonical\" href=\"https://playground.nabi-lang.org/\">", "<link rel=\"canonical\" href=\"https://playground.nabi-lang.org/ko\">"),
    ("<meta property=\"og:url\" content=\"https://playground.nabi-lang.org/\">", "<meta property=\"og:url\" content=\"https://playground.nabi-lang.org/ko\">"),
    ("<a class=\"brand\" href=\"/\">", "<a class=\"brand\" href=\"/ko\">"),
    (">Skip to the editor<", ">편집기로 건너뛰기<"),
    ("aria-label=\"Playground\"", "aria-label=\"플레이그라운드\""),
    ("title=\"Run (Ctrl+Enter)\"", "title=\"실행 (Ctrl+Enter)\""),
    ("</svg>Run</button>", "</svg>실행</button>"),
    ("<span class=\"sr-only\">Example</span>", "<span class=\"sr-only\">예제</span>"),
    ("<span class=\"sr-only\">Optimization level</span>", "<span class=\"sr-only\">최적화 수준</span>"),
    ("-O0 · debug", "-O0 · 디버그"),
    ("-O2 · release", "-O2 · 릴리스"),
    ("title=\"Lay the code out with nabi fmt\">Format<", "title=\"nabi fmt로 코드를 정리합니다\">정리<"),
    ("id=\"share\">Share<", "id=\"share\">공유<"),
    ("aria-label=\"More\" title=\"More\"", "aria-label=\"더 보기\" title=\"더 보기\""),
    (">Copy this link:<", ">이 링크를 복사하세요:<"),
    ("id=\"share-close\">Close<", "id=\"share-close\">닫기<"),
    ("aria-label=\"Source\"", "aria-label=\"소스\""),
    ("title=\"Put the example back as it was (Undo brings your edits back)\">Reset example<", "title=\"예제를 처음 상태로 되돌립니다 (실행 취소로 고친 내용을 되살릴 수 있습니다)\">예제 되돌리기<"),
    ("aria-label=\"Nabi source, main.nabi\"", "aria-label=\"Nabi 소스, main.nabi\""),
    (">Tab indents. Press Escape, then Tab, to leave the editor.<", ">Tab은 들여쓰기입니다. 편집기에서 나가려면 Escape를 누른 다음 Tab을 누르세요.<"),
    (">Ln 1, Col 1<", ">줄 1, 열 1<"),
    ("aria-label=\"Resize the panes\"", "aria-label=\"창 크기 조절\""),
    ("aria-label=\"Output\"", "aria-label=\"출력\""),
    ("<span class=\"lbl\">Output</span>", "<span class=\"lbl\">출력</span>"),
    ("title=\"Text the program reads as its standard input\">Input<", "title=\"프로그램이 표준 입력으로 읽는 텍스트\">입력<"),
    ("aria-label=\"Standard input\"", "aria-label=\"표준 입력\""),
    ("placeholder=\"What the program reads from stdin\"", "placeholder=\"프로그램이 stdin에서 읽을 내용\""),
    ("id=\"copy-out\" disabled>Copy<", "id=\"copy-out\" disabled>복사<"),
    ("id=\"clear\">Clear<", "id=\"clear\">지우기<"),
    ("aria-label=\"Program output\"", "aria-label=\"프로그램 출력\""),
    (">Compiled to WebAssembly on the server, run in your browser. One file of up to 64 KiB; no files, network or threads; a run stops after 10 s. Your code stays in this browser until you press Share, which stores a copy on the server for a short link.<",
        ">서버에서 WebAssembly로 컴파일하고 브라우저에서 실행합니다. 64 KiB까지의 파일 하나이며, 파일·네트워크·스레드는 쓸 수 없고, 실행은 10초 뒤에 멈춥니다. 코드는 공유를 누르기 전까지 이 브라우저에만 남고, 공유를 누르면 짧은 링크를 위해 서버에 사본이 저장됩니다.<"),
];

#[test]
fn every_piece_is_on_a_page() {
    let index = try std::fs::read_to_str("static/index.html") catch e { panic(f"{e}"); };
    let lost = try std::fs::read_to_str("static/404.html") catch e { panic(f"{e}"); };
    for (en, _) in PIECES {
        if !index.contains(en) && !lost.contains(en) { panic(f"not on a page: {en}"); }
    }
    expect(split("/ko").0 && split("/ko").1 == "/" && split("/ko/p/abc").1 == "/p/abc" && !split("/kor").0 && split("/p/x").1 == "/p/x", "split");
    expect(path_in("/", true) == "/ko" && path_in("/p/x", true) == "/ko/p/x" && path_in("/p/x", false) == "/p/x", "path_in");
    let ko = page(index, true);
    expect(ko.contains("<html lang=\"ko\"") && ko.contains(">실행</button>") && !ko.contains(">Share<"), "translated");
}

#[cfg(test)]
fn expect(ok: bool, what: str) {
    if !ok { panic(what); }
}
