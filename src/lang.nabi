// The page in each language: `/ko`, `/zh-hans`, `/zh-hant`, their
// `/p/<id>` pages and the 404s under them are static/index.html and
// static/404.html with each English piece below replaced, longest first
// where one holds another. The script's own words are in
// static/ui/text.ts.

use web::lang::Lang;

/// The language of request path `p` and the path in it: `/ko` is `/`
/// in Korean, `/zh-hant/p/x` is `/p/x` in Traditional Chinese.
pub fn split(p: str) -> (Lang, str) { web::lang::split(p) }

/// Path `p` (`/`, `/p/x`) as a page in `l`.
pub fn path_in(p: str, l: Lang) -> str {
    if l.is_en() { return p; }
    if p == "/" { "/" + l.slug() } else { "/" + l.slug() + p }
}

/// The menu's list of languages for the page at `p` (without its
/// language); the script carries the address's #fragment over.
pub fn switch(p: str, l: Lang) -> str {
    let b = StrBuf::new();
    for m in web::lang::ALL {
        if m == l {
            b.push_str(f"<span aria-current=\"true\" lang=\"{m.code()}\">{m.name()}</span>");
        } else {
            b.push_str(f"<a href=\"{path_in(p, m)}\" hreflang=\"{m.code()}\" lang=\"{m.code()}\" data-lang>{m.name()}</a>");
        }
    }
    f"<nav class=\"langs\" aria-label=\"{l.words().language}\">{b.to_str()}</nav>"
}

/// The header's language menu (web::chrome::lang_menu_for) for the page
/// at `p`; on a phone the header hides it and the menu's switch stays.
pub fn menu(p: str, l: Lang) -> str {
    web::chrome::lang_menu_for(l, web::chrome::menu_items(l, |m| path_in(p, m)))
}

/// `html` in `l`.
pub fn page(html: str, l: Lang) -> str {
    if l.is_en() { return html; }
    let here = "https://playground.nabi-lang.org" + path_in("/", l);
    let out = html.replace("<html lang=\"en\"", f"<html lang=\"{l.code()}\"")
        .replace("content=\"en_US\"", f"content=\"{l.og_locale()}\"")
        .replace("<link rel=\"canonical\" href=\"https://playground.nabi-lang.org/\">", f"<link rel=\"canonical\" href=\"{here}\">")
        .replace("<meta property=\"og:url\" content=\"https://playground.nabi-lang.org/\">", f"<meta property=\"og:url\" content=\"{here}\">")
        .replace("<a class=\"brand\" href=\"/\">", f"<a class=\"brand\" href=\"{path_in("/", l)}\">");
    for (en, ko, hans, hant) in PIECES {
        out = out.replace(en, match l { Lang::Ko => ko, Lang::ZhHans => hans, Lang::ZhHant => hant, Lang::En => en });
    }
    out
}

/// The server's own words on a page, by language.
pub struct Words {
    /// A 404's sentence, and the way back.
    pub no_page: str;
    pub back: str;
    /// A taken-down share: its title, its heading, the plain answer, and
    /// the sentence before and after the address questions go to.
    pub gone_title: str;
    pub gone: str;
    pub gone_plain: str;
    pub gone_pre: str;
    pub gone_post: str;
    /// Before the list of packages in the note, and what joins them.
    pub packages: str;
    pub sep: str;
    pub stop: str;
}

pub fn words(l: Lang) -> Words {
    match l {
        Lang::En => Words {
            no_page: "There is no page at this address.", back: "Back to the playground",
            gone_title: "Link removed · Nabi Playground", gone: "Link removed", gone_plain: "This link was taken down.",
            gone_pre: "The code at this link was taken down. Questions go to ", gone_post: ".",
            packages: " Official packages are ready to use: ", sep: ", ", stop: ".",
        },
        Lang::Ko => Words {
            no_page: "이 주소에는 페이지가 없습니다.", back: "플레이그라운드로 돌아가기",
            gone_title: "내려진 링크 · Nabi 플레이그라운드", gone: "내려진 링크", gone_plain: "이 링크는 내려졌습니다.",
            gone_pre: "이 링크의 코드는 요청에 따라 내려졌습니다. 문의는 ", gone_post: "로 보내 주세요.",
            packages: " 공식 패키지를 바로 쓸 수 있습니다: ", sep: ", ", stop: ".",
        },
        Lang::ZhHans => Words {
            no_page: "此地址没有页面。", back: "返回 Playground",
            gone_title: "链接已撤下 · Nabi Playground", gone: "链接已撤下", gone_plain: "此链接已被撤下。",
            gone_pre: "此链接中的代码已应要求撤下。如有疑问，请发邮件至 ", gone_post: "。",
            packages: "可以直接使用以下官方包：", sep: "、", stop: "。",
        },
        Lang::ZhHant => Words {
            no_page: "此網址沒有頁面。", back: "返回 Playground",
            gone_title: "連結已撤下 · Nabi Playground", gone: "連結已撤下", gone_plain: "此連結已被撤下。",
            gone_pre: "此連結中的程式碼已應要求撤下。如有疑問，請寄信至 ", gone_post: "。",
            packages: "可以直接使用以下官方套件：", sep: "、", stop: "。",
        },
    }
}

