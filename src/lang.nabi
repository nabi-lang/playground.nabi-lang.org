];

#[test]
fn every_piece_is_on_a_page() {
    let index = try std::fs::read_to_str("static/index.html") catch e { panic(f"{e}"); };
    let lost = try std::fs::read_to_str("static/404.html") catch e { panic(f"{e}"); };
    for (en, _, _, _) in PIECES {
        if !index.contains(en) && !lost.contains(en) { panic(f"not on a page: {en}"); }
    }
    let (k, kp) = split("/ko");
    let (h, hp) = split("/zh-hant/p/abc");
    let (e, ep) = split("/kor");
    expect(k == Lang::Ko && kp == "/" && h == Lang::ZhHant && hp == "/p/abc" && e == Lang::En && ep == "/kor", "split");
    expect(path_in("/", Lang::Ko) == "/ko" && path_in("/p/x", Lang::ZhHans) == "/zh-hans/p/x" && path_in("/p/x", Lang::En) == "/p/x", "path_in");
    let ko = page(index, Lang::Ko);
    expect(ko.contains("<html lang=\"ko\"") && ko.contains(">실행</button>") && !ko.contains(">Share<"), "translated");
    for l in [Lang::ZhHans, Lang::ZhHant] {
        let zh = page(index, l);
        expect(zh.contains(f"<html lang=\"{l.code()}\"") && zh.contains(f"<link rel=\"canonical\" href=\"https://playground.nabi-lang.org/{l.slug()}\">") && zh.contains(f"content=\"{l.og_locale()}\""), l.code());
        // what is left in English is code, names and markup
        for (en, _, hans, hant) in PIECES {
            let mine = if l == Lang::ZhHans { hans } else { hant };
            if mine != en { expect(!zh.contains(en), en); }
        }
    }
    let s = switch("/p/x", Lang::ZhHant);
    expect(s.contains("<span aria-current=\"true\" lang=\"zh-Hant\">繁體中文</span>") && s.contains("<a href=\"/zh-hans/p/x\" hreflang=\"zh-Hans\"") && s.contains("<a href=\"/p/x\" hreflang=\"en\"") && s.contains("aria-label=\"語言\""), s);
    let m = menu("/", Lang::ZhHans);
    expect(m.contains("href=\"/zh-hant\" hreflang=\"zh-Hant\"") && m.contains("href=\"/ko\" hreflang=\"ko\"") && m.contains("<span aria-current=\"true\" lang=\"zh-Hans\">"), m);
}

#[cfg(test)]
fn expect(ok: bool, what: str) {
    if !ok { panic(what); }
}
