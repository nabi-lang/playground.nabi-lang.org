{
  "name": "playground.nabi-lang.org",
  "private": true,
  "type": "module",
  "description": "TypeScript and TSX for the page scripts: npm run build bundles the .js the site builds in, npm run check type-checks",
  "scripts": {
    "build": "node --no-warnings web/tools/build.ts web/js static",
    "check": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "preact": "10.29.8",
    "style-mod": "4.1.5",
    "web-tree-sitter": "0.27.1"
  }
}
