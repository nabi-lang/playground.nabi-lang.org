// Linear algebra with the `linalg` package: solve A x = b, check the
// residual, and look at A's eigenvalues.
use core::array::{Matrix, Vector};

fn main() throws {
    let a: Matrix<f64> = [[4, 1, 0], [1, 3, 1], [0, 1, 2]];
    let b: Vector<f64> = [1, 2, 3];
    let x = try linalg::solve(a, b);
    println(f"x = {x:?}");
    println(f"|A x - b| = {a @ x .- b |> linalg::norm:.1e}");
    let e = try linalg::eigh(a);
    println(f"eigenvalues {e.values():?}, cond {try linalg::cond(a):.3}");
}
