// Statistics with the `stats` package: a summary of some measurements
// and how well two of them go together.
fn main() throws {
    let heights = [1.62, 1.75, 1.68, 1.80, 1.71, 1.66, 1.77];
    let weights = [55.0, 72.0, 63.0, 81.0, 68.0, 60.0, 75.0];
    println(f"mean height {stats::mean(heights):.3} m, std {stats::std(heights, ddof: 1):.3} m");
    let r = try stats::pearson(heights, weights);
    println(f"height and weight: r = {r:.3}");
}
